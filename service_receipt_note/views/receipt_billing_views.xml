<odoo>
    <record id="service_receipt_bill_form" model="ir.ui.view">
        <field name="name">service.receipt.bill.form.reverted</field>
        <field name="model">service.receipt.note</field>
        <field name="inherit_id" ref="view_service_receipt_note_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml"><xpath expr="//form" position="inside"><field name="id" invisible="1"/></xpath></field>
    </record>
    <record id="goods_receipt_bill_form" model="ir.ui.view">
        <field name="name">stock.picking.receipt.bill.reverted</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml"><xpath expr="//form" position="inside"><field name="id" invisible="1"/></xpath></field>
    </record>
    <record id="purchase_receipt_only_billing" model="ir.ui.view">
        <field name="name">purchase.order.receipt.only.billing.reverted</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml"><xpath expr="//form" position="inside"><field name="id" invisible="1"/></xpath></field>
    </record>
    <record id="account_move_receipt_source" model="ir.ui.view">
        <field name="name">account.move.receipt.source.reverted</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml"><xpath expr="//form" position="inside"><field name="id" invisible="1"/></xpath></field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_related_receipts" model="ir.ui.view">
        <field name="name">account.payment.form.related.purchase.receipts</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_pr_related_grns"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="pr_related_grn_count == 0">
                    <field name="pr_related_grn_count" widget="statinfo" string="GRNs"/>
                </button>
                <button name="action_open_pr_related_srns"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-check-square-o"
                        invisible="pr_related_srn_count == 0">
                    <field name="pr_related_srn_count" widget="statinfo" string="SRNs"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

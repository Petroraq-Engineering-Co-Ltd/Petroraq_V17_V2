<odoo>
    <record id="group_service_receipt_user" model="res.groups">
        <field name="name">Service Receipts: Requester</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_service_receipt_qc" model="res.groups">
        <field name="name">Service Receipts: QC</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_service_receipt_manager" model="res.groups">
        <field name="name">Service Receipts: Department Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Company Isolation Rules -->
    <record id="receipt_company_rule" model="ir.rule">
        <field name="name">SRN company isolation</field>
        <field name="model_id" ref="model_service_receipt_note"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="receipt_line_company_rule" model="ir.rule">
        <field name="name">SRN line company isolation</field>
        <field name="model_id" ref="model_service_receipt_note_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- SRN Record Rules -->
    <record id="receipt_requester_rule" model="ir.rule">
        <field name="name">SRN requesters: own receipts only</field>
        <field name="model_id" ref="model_service_receipt_note"/>
        <field name="groups" eval="[(4, ref('group_service_receipt_user'))]"/>
        <field name="domain_force">['|', ('requested_user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
    </record>
    <record id="receipt_qc_rule" model="ir.rule">
        <field name="name">SRN QC: company receipts</field>
        <field name="model_id" ref="model_service_receipt_note"/>
        <field name="groups" eval="[(4, ref('group_service_receipt_qc'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="receipt_manager_rule" model="ir.rule">
        <field name="name">SRN department managers: department receipts</field>
        <field name="model_id" ref="model_service_receipt_note"/>
        <field name="groups" eval="[(4, ref('group_service_receipt_manager'))]"/>
        <field name="domain_force">['|', ('department_manager_id', '=', user.id), ('create_uid', '=', user.id)]</field>
    </record>
    <record id="receipt_purchase_account_rule" model="ir.rule">
        <field name="name">SRN procurement and accounting visibility</field>
        <field name="model_id" ref="model_service_receipt_note"/>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- SRN Line Record Rules -->
    <record id="receipt_line_requester_rule" model="ir.rule">
        <field name="name">SRN lines for requester</field>
        <field name="model_id" ref="model_service_receipt_note_line"/>
        <field name="groups" eval="[(4, ref('group_service_receipt_user'))]"/>
        <field name="domain_force">['|', ('receipt_id.requested_user_id', '=', user.id), ('receipt_id.create_uid', '=', user.id)]</field>
    </record>
    <record id="receipt_line_qc_rule" model="ir.rule">
        <field name="name">SRN lines for QC</field>
        <field name="model_id" ref="model_service_receipt_note_line"/>
        <field name="groups" eval="[(4, ref('group_service_receipt_qc'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="receipt_line_manager_rule" model="ir.rule">
        <field name="name">SRN lines for department manager</field>
        <field name="model_id" ref="model_service_receipt_note_line"/>
        <field name="groups" eval="[(4, ref('group_service_receipt_manager'))]"/>
        <field name="domain_force">['|', ('receipt_id.department_manager_id', '=', user.id), ('receipt_id.create_uid', '=', user.id)]</field>
    </record>
    <record id="receipt_line_purchase_account_rule" model="ir.rule">
        <field name="name">SRN line procurement and accounting visibility</field>
        <field name="model_id" ref="model_service_receipt_note_line"/>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Purchase Order Rules -->
    <record id="service_purchase_requester_rule" model="ir.rule">
        <field name="name">Service requesters: related purchase orders only</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('group_service_receipt_user'))]"/>
        <field name="domain_force">['|', ('requisition_id.requested_user_id', '=', user.id), ('requisition_id.create_uid', '=', user.id)]</field>
    </record>
    <record id="service_purchase_qc_rule" model="ir.rule">
        <field name="name">Service QC: company purchase orders</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('group_service_receipt_qc'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="service_purchase_manager_rule" model="ir.rule">
        <field name="name">Service managers: department purchase orders</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('group_service_receipt_manager'))]"/>
        <field name="domain_force">['|', ('requisition_id.requested_user_id.employee_ids.department_id.manager_id.user_id', '=', user.id), ('requisition_id.create_uid.employee_ids.department_id.manager_id.user_id', '=', user.id)]</field>
    </record>
    <record id="service_purchase_staff_rule" model="ir.rule">
        <field name="name">Purchase staff retain purchase access</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Purchase Order Line Rules -->
    <record id="service_purchase_line_requester_rule" model="ir.rule">
        <field name="name">Service requesters: related purchase lines only</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('group_service_receipt_user'))]"/>
        <field name="domain_force">['|', ('order_id.requisition_id.requested_user_id', '=', user.id), ('order_id.requisition_id.create_uid', '=', user.id)]</field>
    </record>
    <record id="service_purchase_line_qc_rule" model="ir.rule">
        <field name="name">Service QC: company purchase lines</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('group_service_receipt_qc'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="service_purchase_line_manager_rule" model="ir.rule">
        <field name="name">Service managers: department purchase lines</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('group_service_receipt_manager'))]"/>
        <field name="domain_force">['|', ('order_id.requisition_id.requested_user_id.employee_ids.department_id.manager_id.user_id', '=', user.id), ('order_id.requisition_id.create_uid.employee_ids.department_id.manager_id.user_id', '=', user.id)]</field>
    </record>
    <record id="service_purchase_line_staff_rule" model="ir.rule">
        <field name="name">Purchase staff retain purchase line access</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>

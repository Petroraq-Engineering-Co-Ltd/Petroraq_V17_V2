<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pr_eos_send_wizard_form" model="ir.ui.view">
        <field name="name">pr.eos.send.wizard.form</field>
        <field name="model">pr.eos.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send EOS Final Settlement">
                <sheet>
                    <field name="eos_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="template_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="recipient_mode" widget="radio"/>
                            <field name="employee_email" readonly="1"
                                   invisible="recipient_mode != 'employee'"/>
                            <field name="employee_private_email" readonly="1"
                                   invisible="recipient_mode != 'private'"/>
                            <field name="email_to"/>
                            <field name="email_cc"/>
                            <field name="email_bcc"/>
                        </group>
                        <group>
                            <field name="subject"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </group>
                    </group>
                    <group string="Email Body" col="1">
                        <field name="body_html" widget="html" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

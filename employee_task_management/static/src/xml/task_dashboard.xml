<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="employee_task_management.TaskDashboard" owl="1">
        <div class="o_etm_dashboard">
            <div class="o_etm_banner">
                <div class="o_etm_banner_text">
                    <div class="o_etm_eyebrow">Employee Task Management</div>
                    <h1 class="o_etm_title">Task Dashboard</h1>
                    <div class="o_etm_subtitle">
                        Task lists, approvals, activities, sub-activities and hours in one view.
                    </div>
                </div>
                <button class="btn o_etm_refresh_btn" t-on-click="onRefresh">
                    <i class="fa fa-refresh me-1"/> Refresh
                </button>
            </div>

            <!-- Today's capacity for whoever is looking at the
                 dashboard. Hidden entirely when there is no row for
                 today (a day off, a holiday, or the refresh has not
                 run yet) rather than showing a misleading 00:00. -->
            <div class="o_etm_capacity_strip" t-if="state.counts.idle_has_row">
                <span class="o_etm_capacity_item">
                    <span class="o_etm_capacity_label">Working Hours Today</span>
                    <span class="o_etm_capacity_value"><t t-esc="state.counts.idle_capacity_display"/></span>
                </span>
                <span class="o_etm_capacity_item">
                    <span class="o_etm_capacity_label">Allocated</span>
                    <span class="o_etm_capacity_value"><t t-esc="state.counts.idle_allocated_display"/></span>
                </span>
                <span class="o_etm_capacity_item" t-att-class="state.counts.idle_raw > 0 ? 'o_etm_capacity_idle' : ''">
                    <span class="o_etm_capacity_label">Idle Hours</span>
                    <span class="o_etm_capacity_value"><t t-esc="state.counts.idle_display"/></span>
                </span>
                <span class="o_etm_capacity_hint" t-if="state.counts.idle_raw > 0">
                    Please create tasks/activities for the available time.
                </span>
            </div>
            <div class="o_etm_cards">
                <div class="o_etm_card" t-on-click="() => this.openCard('total')">
                    <div class="o_etm_card_label">Total Tasks</div>
                    <div class="o_etm_card_value"><t t-esc="state.counts.total"/></div>
                </div>
                <div class="o_etm_card" t-on-click="() => this.openCard('pending_approval')">
                    <div class="o_etm_card_label">Pending Manager Approval</div>
                    <div class="o_etm_card_value"><t t-esc="state.counts.pending_approval"/></div>
                </div>
                <div class="o_etm_card" t-on-click="() => this.openCard('in_progress')">
                    <div class="o_etm_card_label">In Progress</div>
                    <div class="o_etm_card_value"><t t-esc="state.counts.in_progress"/></div>
                </div>
                <div class="o_etm_card" t-on-click="() => this.openCard('completed')">
                    <div class="o_etm_card_label">Completed (Not Closed)</div>
                    <div class="o_etm_card_value"><t t-esc="state.counts.completed"/></div>
                </div>
                <div class="o_etm_card o_etm_card_danger" t-on-click="() => this.openCard('delayed')">
                    <div class="o_etm_card_label">Delayed</div>
                    <div class="o_etm_card_value"><t t-esc="state.counts.delayed"/></div>
                </div>
                <div class="o_etm_card" t-on-click="() => this.openCard('closed')">
                    <div class="o_etm_card_label">Closed</div>
                    <div class="o_etm_card_value"><t t-esc="state.counts.closed"/></div>
                </div>
            </div>

            <div class="o_etm_toolbar">
                <div class="o_etm_toolbar_title">Task Lists</div>
                <div class="o_etm_view_switcher">
                    <button class="btn o_etm_switch_btn active" title="List (current view)">
                        <i class="fa fa-list"/>
                    </button>
                    <button class="btn o_etm_switch_btn" title="Open Kanban view"
                            t-on-click="() => this.openView('kanban')">
                        <i class="fa fa-th-large"/>
                    </button>
                    <button class="btn o_etm_switch_btn" title="Open Graph view"
                            t-on-click="() => this.openView('graph')">
                        <i class="fa fa-bar-chart"/>
                    </button>
                </div>
            </div>

            <div class="o_etm_list_wrapper">
                <View t-props="listViewProps" t-key="state.reloadKey"/>
            </div>
        </div>
    </t>

</templates>

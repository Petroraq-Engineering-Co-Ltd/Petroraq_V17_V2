<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ========== Employee Rule (TDD 21) ==========
             Employees can see only their own task lists -->
        <record id="rule_task_list_employee_own" model="ir.rule">
            <field name="name">Task List: Employee sees own only</field>
            <field name="model_id" ref="model_employee_task_list"/>
            <!-- A DRAFT is private to whoever is writing it. Without the
                 second clause a manager drafting a task list for someone
                 shows up in that employee's list before it has been
                 assigned to him. -->
            <field name="domain_force">['&amp;',
                ('employee_id.user_id', '=', user.id),
                '|', ('state', '!=', 'draft'), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_task_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ========== Manager Rule (TDD 21) ==========
             Managers can see task lists of employees reporting to them
             (as immediate manager) plus employees of their department/team -->
        <record id="rule_task_list_manager_team" model="ir.rule">
            <field name="name">Task List: Manager sees team</field>
            <field name="model_id" ref="model_employee_task_list"/>
            <!-- Same draft privacy the other way round: an employee's
                 unsent draft must not appear to his manager until he
                 actually submits it. -->
            <field name="domain_force">['&amp;',
                '|', '|',
                ('manager_id.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id),
                ('department_id.manager_id.user_id', '=', user.id),
                '|', ('state', '!=', 'draft'), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_task_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ========== Admin Rule: full access ========== -->
        <record id="rule_task_list_admin_all" model="ir.rule">
            <field name="name">Task List: Admin full access</field>
            <field name="model_id" ref="model_employee_task_list"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_task_admin'))]"/>
        </record>

        <!-- ========== Task Line rules mirror the parent list ========== -->
        <record id="rule_task_line_employee_own" model="ir.rule">
            <field name="name">Task Line: Employee sees own only</field>
            <field name="model_id" ref="model_employee_task_line"/>
            <field name="domain_force">[('task_list_id.employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_task_employee'))]"/>
        </record>

        <record id="rule_task_line_manager_team" model="ir.rule">
            <field name="name">Task Line: Manager sees team</field>
            <field name="model_id" ref="model_employee_task_line"/>
            <field name="domain_force">['|', '|',
                ('task_list_id.manager_id.user_id', '=', user.id),
                ('task_list_id.employee_id.parent_id.user_id', '=', user.id),
                ('task_list_id.department_id.manager_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_task_manager'))]"/>
        </record>

        <record id="rule_task_line_admin_all" model="ir.rule">
            <field name="name">Task Line: Admin full access</field>
            <field name="model_id" ref="model_employee_task_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_task_admin'))]"/>
        </record>

        <!-- ========== Activity rules mirror the task line ========== -->
        <record id="rule_subtask_employee_own" model="ir.rule">
            <field name="name">Activity: Employee sees own only</field>
            <field name="model_id" ref="model_employee_task_subtask"/>
            <field name="domain_force">[('task_line_id.task_list_id.employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_task_employee'))]"/>
        </record>

        <record id="rule_subtask_manager_team" model="ir.rule">
            <field name="name">Activity: Manager sees team</field>
            <field name="model_id" ref="model_employee_task_subtask"/>
            <field name="domain_force">['|', '|',
                ('task_line_id.task_list_id.manager_id.user_id', '=', user.id),
                ('task_line_id.task_list_id.employee_id.parent_id.user_id', '=', user.id),
                ('task_line_id.task_list_id.department_id.manager_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_task_manager'))]"/>
        </record>

        <record id="rule_subtask_admin_all" model="ir.rule">
            <field name="name">Activity: Admin full access</field>
            <field name="model_id" ref="model_employee_task_subtask"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_task_admin'))]"/>
        </record>

        <!-- ========== Idle / capacity rules ==========
             Mirror the task list rules exactly: an employee sees only
             his own days, a manager sees his team's, an admin sees
             everything. -->
        <record id="rule_idle_day_employee_own" model="ir.rule">
            <field name="name">Idle Hours: Employee sees own only</field>
            <field name="model_id" ref="model_employee_task_idle_day"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_task_employee'))]"/>
        </record>

        <record id="rule_idle_day_manager_team" model="ir.rule">
            <field name="name">Idle Hours: Manager sees team</field>
            <field name="model_id" ref="model_employee_task_idle_day"/>
            <field name="domain_force">['|', '|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id),
                ('department_id.manager_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_task_manager'))]"/>
        </record>

        <record id="rule_idle_day_admin_all" model="ir.rule">
            <field name="name">Idle Hours: Admin full access</field>
            <field name="model_id" ref="model_employee_task_idle_day"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_task_admin'))]"/>
        </record>

        <!-- ============================================================
             BOSS - company-wide READ across every department.
             ============================================================
             FIVE rules, one per model. Widening only the task list would
             let a Boss open a record and find it EMPTY, because the
             lines, activities, history and capacity rows each carry
             their own rules.

             READ ONLY, and that is what makes "edit only his own
             department" work without writing a single write rule.
             Record rules are OR'd across a user's groups, so these ADD
             read access on top of his Task Manager role while granting
             no write, create or delete of their own. Editing therefore
             still falls entirely to the manager rule above - the lists
             he manages, his direct reports, and his own department -
             and every other department is read-only as a consequence.
             Nothing he can edit today changes.

             DRAFTS STAY PRIVATE. An unsent draft is the author's
             scratchpad; the manager rule excludes them for the same
             reason, and "see everything" was never meant to reach into
             work nobody has submitted yet.

             These are model-wide, as all record rules are: the wider
             view applies everywhere these models are read - reports,
             the approvals dashboard, search - not only in the All Task
             Lists menu. Confining it to one menu would need a separate
             read-only model, which was judged not worth it.

             The group grants NO model access of its own, so it is only
             usable alongside a Task role. Boss is a widening flag, not
             a standalone role. -->
        <record id="rule_task_list_boss_all" model="ir.rule">
            <field name="name">Task List: Boss sees all departments (read only)</field>
            <field name="model_id" ref="model_employee_task_list"/>
            <field name="domain_force">['|',
                ('state', '!=', 'draft'),
                ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_task_boss'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_task_line_boss_all" model="ir.rule">
            <field name="name">Task Line: Boss sees all departments (read only)</field>
            <field name="model_id" ref="model_employee_task_line"/>
            <field name="domain_force">['|',
                ('task_list_id.state', '!=', 'draft'),
                ('task_list_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_task_boss'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_subtask_boss_all" model="ir.rule">
            <field name="name">Activity: Boss sees all departments (read only)</field>
            <field name="model_id" ref="model_employee_task_subtask"/>
            <field name="domain_force">['|',
                ('task_line_id.task_list_id.state', '!=', 'draft'),
                ('task_line_id.task_list_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_task_boss'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_approval_history_boss_all" model="ir.rule">
            <field name="name">Approval History: Boss sees all departments (read only)</field>
            <field name="model_id" ref="model_employee_task_approval_history"/>
            <field name="domain_force">['|',
                ('task_list_id.state', '!=', 'draft'),
                ('task_list_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_task_boss'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- No draft clause here: a capacity row is generated by the
             cron from committed work, never drafted by anybody, so
             there is nothing private to protect. -->
        <record id="rule_idle_day_boss_all" model="ir.rule">
            <field name="name">Idle Hours: Boss sees all departments (read only)</field>
            <field name="model_id" ref="model_employee_task_idle_day"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_task_boss'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ========== Approval History rules ========== -->
        <record id="rule_approval_history_employee" model="ir.rule">
            <field name="name">Approval History: Employee sees own</field>
            <field name="model_id" ref="model_employee_task_approval_history"/>
            <field name="domain_force">[('task_list_id.employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_task_employee'))]"/>
        </record>

        <record id="rule_approval_history_manager" model="ir.rule">
            <field name="name">Approval History: Manager sees team</field>
            <field name="model_id" ref="model_employee_task_approval_history"/>
            <field name="domain_force">['|', '|',
                ('task_list_id.manager_id.user_id', '=', user.id),
                ('task_list_id.employee_id.parent_id.user_id', '=', user.id),
                ('task_list_id.department_id.manager_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_task_manager'))]"/>
        </record>

        <record id="rule_approval_history_admin" model="ir.rule">
            <field name="name">Approval History: Admin full access</field>
            <field name="model_id" ref="model_employee_task_approval_history"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_task_admin'))]"/>
        </record>

    </data>
</odoo>

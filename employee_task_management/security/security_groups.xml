<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_employee_task" model="ir.module.category">
            <field name="name">Employee Task Management</field>
            <field name="description">Access rights for Employee Task Management module</field>
            <field name="sequence">25</field>
        </record>

        <!-- employee_task.group_task_employee -->
        <record id="group_task_employee" model="res.groups">
            <field name="name">Task Employee</field>
            <field name="category_id" ref="module_category_employee_task"/>
            <field name="comment">Can create task lists for themselves only, view own task lists, edit in Draft/Returned status, update progress after approval.</field>
        </record>

        <!-- employee_task.group_task_manager -->
        <record id="group_task_manager" model="res.groups">
            <field name="name">Task Manager</field>
            <field name="category_id" ref="module_category_employee_task"/>
            <field name="implied_ids" eval="[(4, ref('group_task_employee'))]"/>
            <field name="comment">Can create/view task lists of employees under their department/team, approve or return submitted task lists, review progress and close completed task lists.</field>
        </record>

        <!-- employee_task.group_task_admin -->
        <record id="group_task_admin" model="res.groups">
            <field name="name">Task Administrator</field>
            <field name="category_id" ref="module_category_employee_task"/>
            <field name="implied_ids" eval="[(4, ref('group_task_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full access to all task lists, configuration and exceptional edits.</field>
        </record>

        <!-- ============================================================
             BOSS - a CHECKBOX, not a fourth role.
             ============================================================
             The three groups above form a ladder inside one category, so
             Odoo renders them as a single dropdown: a user is Employee
             OR Manager OR Administrator. Boss is not another rung on
             that ladder - it is an extra flag that can sit on top of
             whichever role the person already holds.

             It therefore gets its OWN category. A category containing
             exactly one group renders as a tick-box on the user form
             rather than joining the dropdown, which is what lets the
             boss keep his Task Manager role untouched.

             It grants NO rights of its own and implies nothing. It only
             narrows which Employee Tasks cards appear on the Approvals
             Dashboard in de_hr_workspace_attendance - every record rule,
             menu, button and approval check keys off the role groups
             above and is completely unaffected by this. Deliberately so:
             Task Manager is load-bearing across the whole module, and
             changing what it means would alter behaviour for every
             manager in the company. -->
        <record id="module_category_task_oversight" model="ir.module.category">
            <field name="name">Employee Task Oversight</field>
            <field name="description">Narrows the Employee Tasks approval cards to executive-level ones.</field>
            <field name="sequence">26</field>
        </record>

        <record id="group_task_boss" model="res.groups">
            <field name="name">Boss</field>
            <field name="category_id" ref="module_category_task_oversight"/>
            <field name="comment">Shows only the executive Employee Tasks cards on the Approvals Dashboard - Task Lists to Approve, and Completed - Pending Review. The user's own cards are unaffected, and so is every right his Task role already grants him.</field>
        </record>

    </data>
</odoo>

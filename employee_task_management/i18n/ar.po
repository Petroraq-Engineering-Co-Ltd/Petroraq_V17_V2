#, python-format
msgid ""
"Task list %(name)s was completed on %(today)s, %(days)s working day(s) after"
" the planned end date (%(planned)s). %(count)s task(s) finished late."
msgstr ""
"تم إكمال قائمة المهام %(name)s في %(today)s، بعد %(days)s يوم/أيام عمل من تاريخ "
"الانتهاء المخطط (%(planned)s). اكتملت %(count)s مهمة/مهام متأخرة."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"Task list %s has been created and assigned to you by %s. Please review it "
"and click \"Accept\" - or \"Request Modification\" if something needs to "
"change."
msgstr ""
"تم إنشاء قائمة المهام %s وإسنادها إليك بواسطة %s. يرجى مراجعتها والنقر على "
"\"قبول\" - أو \"طلب تعديل\" إذا كان هناك شيء يحتاج إلى تغيير."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/wizard/task_return_wizard.py:0
#, python-format
msgid "Task list %s has been returned to %s for correction."
msgstr "تمت إعادة قائمة المهام %s إلى %s للتصحيح."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"Task list %s has been updated by %s and is ready for you to work on. Please "
"review the changes and click \"Start Work\"."
msgstr ""
"تم تحديث قائمة المهام %s بواسطة %s وهي جاهزة لتعمل عليها. يرجى مراجعة "
"التغييرات والنقر على \"بدء العمل\"."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"Task list %s has no task. Add the tasks and their activities before it "
"becomes applicable - once approved, tasks and activities are frozen."
msgstr ""
"قائمة المهام %s لا تحتوي على أي مهمة. أضف المهام وأنشطتها قبل أن تصبح سارية - "
"بمجرد اعتمادها، يتم تجميد المهام والأنشطة."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/wizard/task_reject_wizard.py:0
#, python-format
msgid "Task list %s of %s has been rejected and closed."
msgstr "تم رفض وإغلاق قائمة المهام %s الخاصة بـ %s."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"Task list %s was assigned to %s automatically - its start date arrived while"
" the task list was still in \"%s\"."
msgstr ""
"تم إسناد قائمة المهام %s إلى %s تلقائيًا - حل تاريخ البدء بينما كانت قائمة "
"المهام لا تزال في حالة \"%s\"."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"Task list accepted by %s while already in progress. %s task(s) approved."
msgstr ""
"تم قبول قائمة المهام بواسطة %s أثناء كونها قيد التنفيذ بالفعل. تم اعتماد "
"%s مهمة/مهام."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid "Task list can only be submitted from Draft or Returned state."
msgstr "يمكن إرسال قائمة المهام فقط من حالة مسودة أو معادة."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"Task list cannot be completed - the following tasks have no activity:\n"
"%s"
msgstr ""
"لا يمكن إكمال قائمة المهام - المهام التالية ليس لها نشاط:\n"
"%s"

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid "Task list cannot be completed without any task."
msgstr "لا يمكن إكمال قائمة المهام بدون أي مهمة."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"Task list cannot be marked as Completed while its progress is below 100%%.\n"
"\n"
"Pending tasks:\n"
"%s"
msgstr ""
"لا يمكن تحديد قائمة المهام كمكتملة بينما تكون نسبة تقدمها أقل من 100%%.\n"
"\n"
"المهام المعلقة:\n"
"%s"

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid "Task list cannot be submitted/assigned without at least one task line."
msgstr "لا يمكن إرسال/إسناد قائمة المهام بدون سطر مهمة واحد على الأقل."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"Task list cannot be submitted: hours are mandatory for every activity of "
"task \"%s\"."
msgstr ""
"لا يمكن إرسال قائمة المهام: الساعات إلزامية لكل نشاط من أنشطة المهمة \"%s\"."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"Task list cannot be submitted: task \"%s\" has no activity. Add at least one"
" activity with hours."
msgstr ""
"لا يمكن إرسال قائمة المهام: المهمة \"%s\" ليس لها نشاط. أضف نشاطًا واحدًا على "
"الأقل مع ساعات."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"Task list closed with %(count)s rejected task(s). They will be added "
"automatically to this employee's next task list."
msgstr ""
"تم إغلاق قائمة المهام مع %(count)s مهمة/مهام مرفوضة. ستتم إضافتها تلقائيًا إلى "
"قائمة المهام التالية لهذا الموظف."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/wizard/task_unlock_wizard.py:0
#, python-format
msgid "Task list unlocked for exceptional editing by %s. Reason: %s"
msgstr "تم إلغاء قفل قائمة المهام للتعديل الاستثنائي بواسطة %s. السبب: %s"

#. module: employee_task_management
#: model_terms:ir.actions.act_window,help:employee_task_management.action_task_list_acceptance
msgid ""
"Task lists assigned to you by your manager appear here until you accept "
"them."
msgstr ""
"تظهر هنا قوائم المهام التي أسندها إليك مديرك حتى تقوم بقبولها."

#. module: employee_task_management
#: model_terms:ir.actions.act_window,help:employee_task_management.action_task_list_employee_tasks
msgid ""
"Task lists belonging to the employees who report to you appear here. Your "
"own task lists are under My Tasks."
msgstr ""
"تظهر هنا قوائم المهام الخاصة بالموظفين الذين يتبعون لك. قوائم المهام الخاصة "
"بك موجودة ضمن مهامي."

#. module: employee_task_management
#: model_terms:ir.actions.act_window,help:employee_task_management.action_employee_task_pending_my_action
msgid ""
"Task lists will appear here when your approval, review, modification, or "
"acceptance is required."
msgstr ""
"ستظهر قوائم المهام هنا عندما يكون اعتمادك أو مراجعتك أو تعديلك أو قبولك "
"مطلوبًا."

#. module: employee_task_management
#. odoo-javascript
#: code:addons/employee_task_management/static/src/xml/task_dashboard.xml:0
#, python-format
msgid ""
"Task lists, approvals, activities, sub-activities and hours in one view."
msgstr ""
"قوائم المهام والاعتمادات والأنشطة والأنشطة الفرعية والساعات في عرض واحد."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/wizard/task_line_reject_wizard.py:0
#, python-format
msgid ""
"Task rejected by %(user)s: %(task)s<br/>Reason: %(reason)s<br/><i>It will be"
" added automatically to this employee's next task list.</i>"
msgstr ""
"تم رفض المهمة بواسطة %(user)s: %(task)s<br/>السبب: %(reason)s<br/><i>ستتم "
"إضافتها تلقائيًا إلى قائمة المهام التالية لهذا الموظف.</i>"

#. module: employee_task_management
#: model_terms:ir.actions.act_window,help:employee_task_management.action_task_dashboard
msgid ""
"Task status pie chart, department-wise bar chart, employee-wise completion "
"and monthly trend are available from the measures/views toolbar."
msgstr ""
"يتوفر مخطط دائري لحالات المهام، ومخطط شريطي حسب القسم، ونسبة الإكمال حسب "
"الموظف، والاتجاه الشهري من شريط أدوات المقاييس/العروض."

#. module: employee_task_management
#: model_terms:ir.ui.view,arch_db:employee_task_management.view_employee_task_list_kanban
msgid "Tasks"
msgstr "المهام"

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_line.py:0
#, python-format
msgid ""
"Tasks can no longer be added to or removed from task list \"%s\" - it is in "
"\"%s\" status."
msgstr ""
"لم يعد من الممكن إضافة المهام إلى قائمة المهام \"%s\" أو إزالتها منها - فهي "
"في حالة \"%s\"."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_line.py:0
#, python-format
msgid ""
"Tasks can only be approved or rejected while the task list is Completed, or "
"while it is running without having been approved."
msgstr ""
"يمكن اعتماد المهام أو رفضها فقط بينما تكون قائمة المهام مكتملة، أو بينما تكون "
"قيد التنفيذ دون أن تكون معتمدة."

#. module: employee_task_management
#: model:ir.model.fields,help:employee_task_management.field_employee_task_idle_day__notified_slots
msgid ""
"Technical: which of the daily reminder slots have already fired, so a cron "
"re-run cannot send the same one twice."
msgstr ""
"تقني: أي خانات من خانات التذكير اليومية قد تم تشغيلها بالفعل، بحيث لا يتمكن "
"إعادة تشغيل cron من إرسال الخانة نفسها مرتين."

#. module: employee_task_management
#: model:ir.model.fields,help:employee_task_management.field_employee_task_list__can_act_for_employee
msgid ""
"The employee himself, OR the manager this task list reports to (or an "
"Administrator). A manager may drive his own people's Accept / Start Work / "
"Mark Completed when they are away - and only his own people, never another "
"team's."
msgstr ""
"الموظف نفسه، أو المدير الذي تتبع له قائمة المهام هذه (أو المسؤول). يمكن للمدير "
"تنفيذ إجراءات قبول / بدء العمل / تحديد كمكتمل لموظفيه عندما يكونون غائبين - "
"ولموظفيه فقط، وليس لموظفي فريق آخر."

#. module: employee_task_management
#: model:ir.model.fields,help:employee_task_management.field_employee_task_line__carried_from_line_id
msgid "The rejected task this one was carried forward from."
msgstr "المهمة المرفوضة التي تم ترحيل هذه المهمة منها."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"The start date of task list %s has arrived while it was still waiting in "
"\"%s\", so it has been assigned to you automatically. You may start work."
msgstr ""
"حل تاريخ بدء قائمة المهام %s بينما كانت لا تزال تنتظر في حالة \"%s\"، لذا "
"تم إسنادها إليك تلقائيًا. يمكنك بدء العمل."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"The status of a task list can only be changed with the workflow buttons on "
"the form (Submit, Approve, Accept, Start Work, Mark Completed, Close...)."
msgstr ""
"لا يمكن تغيير حالة قائمة المهام إلا باستخدام أزرار سير العمل في النموذج "
"(إرسال، اعتماد، قبول، بدء العمل، تحديد كمكتملة، إغلاق...)."

#. module: employee_task_management
#: model:ir.model.fields,help:employee_task_management.field_employee_task_line__was_delayed_days
msgid ""
"The worst delayed_days this task has ever recorded. Latched - never "
"decreases, even if the task is later corrected or re-completed on time."
msgstr ""
"أسوأ قيمة لـ delayed_days سجلتها هذه المهمة على الإطلاق. مثبتة - لا تنخفض "
"أبدًا، حتى إذا تم تصحيح المهمة لاحقًا أو إعادة إكمالها في الوقت المحدد."

#. module: employee_task_management
#: model:ir.model.constraint,message:employee_task_management.constraint_employee_task_idle_day_employee_date_uniq
msgid "There can only be one capacity row per employee per day."
msgstr "يمكن أن يكون هناك صف سعة واحد فقط لكل موظف في اليوم."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_line.py:0
#, python-format
msgid ""
"These tasks were carried forward because they were rejected on an earlier task list, so they have to be done:\n"
"%s"
msgstr ""
"تم ترحيل هذه المهام لأنها رُفضت في قائمة مهام سابقة، لذا يجب تنفيذها:\n"
"%s"

#. module: employee_task_management
#: model_terms:ir.ui.view,arch_db:employee_task_management.view_idle_day_search
msgid "This Month"
msgstr "هذا الشهر"

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"This task list belongs to you. Use "Submit to Manager" instead so your "
"manager can approve it."
msgstr ""
"قائمة المهام هذه تخصك. استخدم "إرسال إلى المدير" بدلاً من ذلك حتى يتمكن "
"مديرك من اعتمادها."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"This task list cannot be submitted - not enough capacity on %(day)s.\n"
"\n"
"Employee: %(emp)s\n"
"Task list: %(name)s\n"
"\n"
"Daily capacity: %(cap)s\n"
"Total once this list counts: %(total)s\n"
"Over by: %(over)s\n"
"\n"
"What you can do:\n"
"  - reduce the activity hours on this list\n"
"  - move some tasks to a day with free capacity\n"
"  - extend a task's End Date so its hours spread across more days\n"
"\n"
"Note: hours already spent that day count even if the manager rejected the work. Rejected work is redone on a LATER day, not on the day it failed."
msgstr ""
"لا يمكن إرسال قائمة المهام هذه - لا توجد سعة كافية في يوم %(day)s.\n"
"\n"
"الموظف: %(emp)s\n"
"قائمة المهام: %(name)s\n"
"\n"
"السعة اليومية: %(cap)s\n"
"الإجمالي بعد احتساب هذه القائمة: %(total)s\n"
"التجاوز بمقدار: %(over)s\n"
"\n"
"يمكنك القيام بما يلي:\n"
"  - تقليل ساعات الأنشطة في هذه القائمة\n"
"  - نقل بعض المهام إلى يوم تتوفر فيه سعة إضافية\n"
"  - تمديد تاريخ انتهاء المهمة حتى تتوزع ساعاتها على عدد أكبر من الأيام\n"
"\n"
"ملاحظة: تُحتسب الساعات التي تم قضاؤها بالفعل في ذلك اليوم حتى لو رفض المدير العمل. تتم إعادة العمل المرفوض في يوم لاحق، وليس في اليوم الذي تم فيه رفضه."

#. module: employee_task_management
#: model_terms:ir.ui.view,arch_db:employee_task_management.view_employee_task_line_form_subtasks
msgid ""
"This task list is approved, so its activities are frozen. Tick\n"
"                        them off as <b>Done</b> as you complete them - Progress % and the\n"
"                        task status update automatically. A Manager can still correct\n"
"                        the <b>Hours</b> on an activity, or delete an activity outright\n"
"                        to take those hours off the employee's day; either change is\n"
"                        recorded in the task list's chatter."
msgstr ""
"تم اعتماد قائمة المهام هذه، لذلك تم تجميد أنشطتها. قم بتحديدها كـ <b>مكتملة</b>\n"
"                        عند الانتهاء منها - يتم تحديث نسبة التقدم وحالة المهمة تلقائياً.\n"
"                        ولا يزال بإمكان المدير تصحيح <b>الساعات</b> الخاصة بأي نشاط، أو حذف\n"
"                        النشاط بالكامل لإزالة تلك الساعات من يوم الموظف؛ ويتم تسجيل أي من\n"
"                        هذين التغييرين في سجل المحادثة الخاص بقائمة المهام."

#. module: employee_task_management
#: model_terms:ir.ui.view,arch_db:employee_task_management.view_employee_task_list_form
msgid ""
"This task list is approved, so the tasks and activities are\n"
"                                frozen. You can still update <b>Remarks</b> here, and tick\n"
"                                activities off as <b>Done</b> from the Activities button."
msgstr ""
"تم اعتماد قائمة المهام هذه، لذلك تم تجميد المهام والأنشطة.\n"
"                                ولا يزال بإمكانك تحديث <b>الملاحظات</b> هنا، وتحديد\n"
"                                الأنشطة كـ <b>مكتملة</b> من زر الأنشطة."

#. module: employee_task_management
#: model_terms:ir.ui.view,arch_db:employee_task_management.view_employee_task_line_form_subtasks
msgid ""
"This task list is locked for the employee. A Manager can still\n"
"                        correct the <b>Hours</b> on an activity - every change is\n"
"                        recorded in the task list's chatter. Nothing else can be\n"
"                        changed here."
msgstr ""
"قائمة المهام هذه مقفلة بالنسبة للموظف. ولا يزال بإمكان المدير\n"
"                        تصحيح <b>الساعات</b> الخاصة بأي نشاط - ويتم تسجيل كل تغيير\n"
"                        في سجل المحادثة الخاص بقائمة المهام. ولا يمكن تغيير أي شيء\n"
"                        آخر هنا."

#. module: employee_task_management
#: model:ir.model.fields,help:employee_task_management.field_employee_task_list__started_without_approval
msgid ""
"This task list started on its own start date, so the employee began work "
"immediately. It still needs the manager to accept or reject it."
msgstr ""
"بدأت قائمة المهام هذه في تاريخ البدء المحدد لها، ولذلك بدأ الموظف العمل "
"مباشرةً. ولا تزال بحاجة إلى قبول المدير أو رفضه."

#. module: employee_task_management
#: model:ir.model.fields,help:employee_task_management.field_employee_task_line__is_carried_forward
msgid ""
"This task was auto-added because a manager rejected it on an earlier task "
"list. The employee cannot remove it."
msgstr ""
"تمت إضافة هذه المهمة تلقائياً لأن المدير رفضها في قائمة مهام سابقة. ولا يمكن "
"للموظف حذفها."

#. module: employee_task_management
#: model_terms:ir.ui.view,arch_db:employee_task_management.view_task_line_reject_wizard_form
msgid ""
"This task will be marked Rejected. It is added\n"
"                    automatically to this employee's next task list -\n"
"                    carrying only the activities that were not completed,\n"
"                    with its dates left blank for them to re-plan. They\n"
"                    cannot remove it. (If every activity was already\n"
"                    ticked done, the whole set comes back reset, so there\n"
"                    is always something to redo.)"
msgstr ""
"سيتم وضع علامة رفض على هذه المهمة. وستتم إضافتها\n"
"                    تلقائياً إلى قائمة المهام التالية لهذا الموظف -\n"
"                    مع نقل الأنشطة التي لم تكتمل فقط،\n"
"                    وترك تواريخها فارغة ليتم التخطيط لها من جديد. ولا يمكنهم\n"
"                    حذفها. (إذا كانت جميع الأنشطة قد تم تحديدها كمكتملة بالفعل،\n"
"                    فستتم إعادة المجموعة بالكامل بحالتها المعاد ضبطها، بحيث يكون هناك\n"
"                    دائماً شيء يجب إعادة تنفيذه.)"

#. module: employee_task_management
#: model_terms:ir.ui.view,arch_db:employee_task_management.view_idle_day_search
msgid "Today"
msgstr "اليوم"

#. module: employee_task_management
#: model_terms:ir.ui.view,arch_db:employee_task_management.view_idle_day_search
msgid "Today and Later"
msgstr "اليوم وما بعده"

#. module: employee_task_management
#: model_terms:ir.ui.view,arch_db:employee_task_management.view_employee_task_line_form_subtasks
msgid "Total Activities"
msgstr "إجمالي الأنشطة"

#. module: employee_task_management
#: model_terms:ir.ui.view,arch_db:employee_task_management.view_employee_task_line_form_subtasks
#: model_terms:ir.ui.view,arch_db:employee_task_management.view_employee_task_list_form
#: model_terms:ir.ui.view,arch_db:employee_task_management.view_employee_task_subtask_tree
msgid "Total Hours"

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid " (%s)"
msgstr " (%s)"

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"%(count)s task(s) rejected on an earlier task list were added here "
"automatically and must be redone. Only the activities that were not "
"completed have come across, dated %(day)s - change the dates to suit your "
"plan."
msgstr ""
"تمت إضافة %(count)s مهمة مرفوضة من قائمة مهام سابقة إلى هنا تلقائيًا، ويجب "
"إعادة تنفيذها. تم نقل الأنشطة التي لم تكتمل فقط، وتاريخها %(day)s - قم "
"بتغيير التواريخ بما يتناسب مع خطتك."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"%(who)s has planned the activities for task list %(ref)s and submitted them "
"for your review. You can approve them, adjust the hours, or return the list."
msgstr ""
"قام %(who)s بتخطيط الأنشطة لقائمة المهام %(ref)s وأرسلها للمراجعة. يمكنك "
"اعتمادها، أو تعديل الساعات، أو إعادة القائمة."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"%(who)s planned the activities for this task list and submitted them for "
"review."
msgstr ""
"قام %(who)s بتخطيط الأنشطة لقائمة المهام هذه وأرسلها للمراجعة."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid "%s task list \"%s\" is final and cannot be edited."
msgstr "قائمة المهام %s \"%s\" نهائية ولا يمكن تعديلها."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid "<b>%(what)s</b> was done by %(actor)s on behalf of %(employee)s."
msgstr "تم تنفيذ <b>%(what)s</b> بواسطة %(actor)s نيابةً عن %(employee)s."

#. module: employee_task_management
#. odoo-python
#: code:addons/employee_task_management/models/employee_task_list.py:0
#, python-format
msgid ""
"<b>Work started immediately</b> - %(now)s task(s) were due today. %(later)s "
"task(s) dated later are still waiting for the manager's decision."
msgstr ""
"<b>بدأ العمل فورًا</b> - كان موعد استحقاق %(now)s مهمة/مهام اليوم. ولا تزال "
"%(later)s مهمة/مهام ذات تواريخ لاحقة بانتظار قرار المدير."

#. module: employee_task_management
#: model:mail.template,body_html:employee_task_management.mail_template_task_assigned
msgid ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>Dear <t t-out=\"object.employee_id.name\"></t>,</p>\n"
"    <p>A new task list <b><t t-out=\"object.name\"></t></b> has been created and\n"
"       assigned to you by your manager. It is already approved and applicable.</p>\n"
"    <table style=\"border-collapse:collapse;margin:12px 0;\">\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>Department:</b></td><td><t t-out=\"object.department_id.name\"></t></td></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>Assign Date:</b></td><td><t t-out=\"object.assign_date\"></t></td></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>Number of Tasks:</b></td><td><t t-out=\"object.task_count\"></t></td></tr>\n"
"    </table>\n"
"    <p>Please log in, review the tasks and click <b>Start Work</b> to begin.</p>\n"
"    <p>Regards,<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>عزيزي <t t-out=\"object.employee_id.name\"></t>،</p>\n"
"    <p>تم إنشاء قائمة مهام جديدة <b><t t-out=\"object.name\"></t></b> وتكليفك بها\n"
"       من قِبل مديرك. وقد تمت الموافقة عليها وهي سارية بالفعل.</p>\n"
"    <table style=\"border-collapse:collapse;margin:12px 0;\">\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>القسم:</b></td><td><t t-out=\"object.department_id.name\"></t></td></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>تاريخ التكليف:</b></td><td><t t-out=\"object.assign_date\"></t></td></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>عدد المهام:</b></td><td><t t-out=\"object.task_count\"></t></td></tr>\n"
"    </table>\n"
"    <p>يرجى تسجيل الدخول ومراجعة المهام ثم النقر على <b>بدء العمل</b> للبدء.</p>\n"
"    <p>مع التحية،<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "

#. module: employee_task_management
#: model:mail.template,body_html:employee_task_management.mail_template_task_auto_applied
msgid ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>Dear <t t-out=\"object.employee_id.name\"></t>,</p>\n"
"    <p>Task list <b><t t-out=\"object.name\"></t></b> has been\n"
"       <b>assigned automatically</b> because the start date of its work\n"
"       arrived while it was still waiting.</p>\n"
"    <p>You may now click <b>Start Work</b> and begin execution.</p>\n"
"    <p>Regards,<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>عزيزي <t t-out=\"object.employee_id.name\"></t>،</p>\n"
"    <p>تم <b>تعيين قائمة المهام تلقائيًا</b> <b><t t-out=\"object.name\"></t></b>\n"
"       لأن تاريخ بدء العمل عليها قد حان بينما كانت لا تزال قيد الانتظار.</p>\n"
"    <p>يمكنك الآن النقر على <b>بدء العمل</b> والبدء في التنفيذ.</p>\n"
"    <p>مع التحية،<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "

#. module: employee_task_management
#: model:mail.template,body_html:employee_task_management.mail_template_task_resubmitted
msgid ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>Dear <t t-out=\"object.employee_id.name\"></t>,</p>\n"
"    <p>Task list <b><t t-out=\"object.name\"></t></b> has been reviewed and updated by\n"
"       your manager <b><t t-out=\"object.manager_id.name\"></t></b>. It is approved\n"
"       and ready for you to work on again.</p>\n"
"    <table style=\"border-collapse:collapse;margin:12px 0;\">\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>Department:</b></td><td><t t-out=\"object.department_id.name\"></t></td></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>Assign Date:</b></td><td><t t-out=\"object.assign_date\"></t></td></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>Number of Tasks:</b></td><td><t t-out=\"object.task_count\"></t></td></tr>\n"
"    </table>\n"
"    <p>Please review the updated tasks and click <b>Start Work</b> to continue.</p>\n"
"    <p>Regards,<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>عزيزي <t t-out=\"object.employee_id.name\"></t>،</p>\n"
"    <p>تمت مراجعة وتحديث قائمة المهام <b><t t-out=\"object.name\"></t></b> بواسطة\n"
"       مديرك <b><t t-out=\"object.manager_id.name\"></t></b>. وقد تمت الموافقة عليها\n"
"       وأصبحت جاهزة للعمل عليها مرة أخرى.</p>\n"
"    <table style=\"border-collapse:collapse;margin:12px 0;\">\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>القسم:</b></td><td><t t-out=\"object.department_id.name\"></t></td></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>تاريخ التكليف:</b></td><td><t t-out=\"object.assign_date\"></t></td></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>عدد المهام:</b></td><td><t t-out=\"object.task_count\"></t></td></tr>\n"
"    </table>\n"
"    <p>يرجى مراجعة المهام المحدثة والنقر على <b>بدء العمل</b> للمتابعة.</p>\n"
"    <p>مع التحية،<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "

#. module: employee_task_management
#: model:mail.template,body_html:employee_task_management.mail_template_task_rejected
msgid ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>Dear <t t-out=\"object.employee_id.name\"></t>,</p>\n"
"    <p>Your completed task list <b><t t-out=\"object.name\"></t></b> has been\n"
"       <b style=\"color:#b3261e;\">rejected</b> by your manager\n"
"       <t t-out=\"object.manager_id.name\"></t> and is now closed.</p>\n"
"    <t t-if=\"object.reject_reason\">\n"
"        <p><b>Reject Reason:</b><br><t t-out=\"object.reject_reason\"></t></p>\n"
"    </t>\n"
"    <p>Regards,<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>عزيزي <t t-out=\"object.employee_id.name\"></t>،</p>\n"
"    <p>تم <b style=\"color:#b3261e;\">رفض</b> قائمة المهام المكتملة الخاصة بك\n"
"       <b><t t-out=\"object.name\"></t></b> بواسطة مديرك\n"
"       <t t-out=\"object.manager_id.name\"></t>، وأصبحت الآن مغلقة.</p>\n"
"    <t t-if=\"object.reject_reason\">\n"
"        <p><b>سبب الرفض:</b><br><t t-out=\"object.reject_reason\"></t></p>\n"
"    </t>\n"
"    <p>مع التحية،<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "

#. module: employee_task_management
#: model:mail.template,body_html:employee_task_management.mail_template_task_modified
msgid ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>Dear <t t-out=\"object.employee_id.name\"></t>,</p>\n"
"    <p>Your modification request on task list <b><t t-out=\"object.name\"></t></b>\n"
"       has been handled by your manager\n"
"       <b><t t-out=\"object.manager_id.name\"></t></b>.</p>\n"
"    <p>Please review the updated task list and click <b>Accept</b>.</p>\n"
"    <p>Regards,<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>عزيزي <t t-out=\"object.employee_id.name\"></t>،</p>\n"
"    <p>تم التعامل مع طلب التعديل الخاص بك على قائمة المهام <b><t t-out=\"object.name\"></t></b>\n"
"       بواسطة مديرك\n"
"       <b><t t-out=\"object.manager_id.name\"></t></b>.</p>\n"
"    <p>يرجى مراجعة قائمة المهام المحدثة والنقر على <b>قبول</b>.</p>\n"
"    <p>مع التحية،<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "

#. module: employee_task_management
#: model:mail.template,body_html:employee_task_management.mail_template_task_approved
msgid ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>Dear <t t-out=\"object.employee_id.name\"></t>,</p>\n"
"    <p>Your task list <b><t t-out=\"object.name\"></t></b> has been approved by your\n"
"       manager <b><t t-out=\"object.manager_id.name\"></t></b> and is now applicable.</p>\n"
"    <p>You may now start work and update your activities and progress.</p>\n"
"    <p>Regards,<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>عزيزي <t t-out=\"object.employee_id.name\"></t>،</p>\n"
"    <p>تمت الموافقة على قائمة المهام الخاصة بك <b><t t-out=\"object.name\"></t></b> من قِبل\n"
"       مديرك <b><t t-out=\"object.manager_id.name\"></t></b>، وأصبحت الآن سارية.</p>\n"
"    <p>يمكنك الآن بدء العمل وتحديث أنشطتك وتقدمك.</p>\n"
"    <p>مع التحية،<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "

#. module: employee_task_management
#: model:mail.template,body_html:employee_task_management.mail_template_task_returned
msgid ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>Dear <t t-out=\"object.employee_id.name\"></t>,</p>\n"
"    <p>Your task list <b><t t-out=\"object.name\"></t></b> has been returned.\n"
"       Please review the remarks, make corrections, and resubmit.</p>\n"
"    <t t-if=\"object.return_reason\">\n"
"        <p><b>Return Reason:</b><br><t t-out=\"object.return_reason\"></t></p>\n"
"    </t>\n"
"    <p>Regards,<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>عزيزي <t t-out=\"object.employee_id.name\"></t>،</p>\n"
"    <p>تمت إعادة قائمة المهام الخاصة بك <b><t t-out=\"object.name\"></t></b>.\n"
"       يرجى مراجعة الملاحظات وإجراء التصحيحات ثم إعادة إرسالها.</p>\n"
"    <t t-if=\"object.return_reason\">\n"
"        <p><b>سبب الإعادة:</b><br><t t-out=\"object.return_reason\"></t></p>\n"
"    </t>\n"
"    <p>مع التحية،<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "

#. module: employee_task_management
#: model:mail.template,body_html:employee_task_management.mail_template_task_closed
msgid ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>Dear <t t-out=\"object.employee_id.name\"></t>,</p>\n"
"    <p>Your task list <b><t t-out=\"object.name\"></t></b> has been reviewed and\n"
"       <b>closed</b> by your manager. The record remains available for reporting.</p>\n"
"    <p>Regards,<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>عزيزي <t t-out=\"object.employee_id.name\"></t>،</p>\n"
"    <p>تمت مراجعة قائمة المهام الخاصة بك <b><t t-out=\"object.name\"></t></b> و<b>إغلاقها</b>\n"
"       بواسطة مديرك. ولا يزال السجل متاحًا لأغراض التقارير.</p>\n"
"    <p>مع التحية،<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "

#. module: employee_task_management
#: model:mail.template,body_html:employee_task_management.mail_template_task_submitted
msgid ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>Dear <t t-out=\"object.manager_id.name or 'Manager'\"></t>,</p>\n"
"    <p>A new task list has been submitted by employee\n"
"       <b><t t-out=\"object.employee_id.name\"></t></b> and requires your approval.</p>\n"
"    <table style=\"border-collapse:collapse;margin:12px 0;\">\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>Reference:</b></td><td><t t-out=\"object.name\"></t></td></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>Department:</b></td><td><t t-out=\"object.department_id.name\"></t></td></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>Assign Date:</b></td><td><t t-out=\"object.assign_date\"></t></td></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>Number of Tasks:</b></td><td><t t-out=\"object.task_count\"></t></td></tr>\n"
"    </table>\n"
"    <p>Please log in to review, approve or return the task list.</p>\n"
"    <p>Regards,<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>عزيزي <t t-out=\"object.manager_id.name or 'Manager'\"></t>،</p>\n"
"    <p>تم إرسال قائمة مهام جديدة بواسطة الموظف\n"
"       <b><t t-out=\"object.employee_id.name\"></t></b>، وهي تتطلب موافقتك.</p>\n"
"    <table style=\"border-collapse:collapse;margin:12px 0;\">\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>المرجع:</b></td><td><t t-out=\"object.name\"></t></td></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>القسم:</b></td><td><t t-out=\"object.department_id.name\"></t></td></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>تاريخ التكليف:</b></td><td><t t-out=\"object.assign_date\"></t></td></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;\"><b>عدد المهام:</b></td><td><t t-out=\"object.task_count\"></t></td></tr>\n"
"    </table>\n"
"    <p>يرجى تسجيل الدخول لمراجعة قائمة المهام واعتمادها أو إعادتها.</p>\n"
"    <p>مع التحية،<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "

#. module: employee_task_management
#: model:mail.template,body_html:employee_task_management.mail_template_task_accepted
msgid ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>Dear <t t-out=\"object.manager_id.name or 'Manager'\"></t>,</p>\n"
"    <p>Employee <b><t t-out=\"object.employee_id.name\"></t></b> has <b>accepted</b>\n"
"       task list <b><t t-out=\"object.name\"></t></b>. It is now applicable and the\n"
"       employee can start the work.</p>\n"
"    <p>Regards,<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>عزيزي <t t-out=\"object.manager_id.name or 'Manager'\"></t>،</p>\n"
"    <p>قام الموظف <b><t t-out=\"object.employee_id.name\"></t></b> <b>بقبول</b>\n"
"       قائمة المهام <b><t t-out=\"object.name\"></t></b>. وأصبحت الآن سارية، ويمكن\n"
"       للموظف بدء العمل.</p>\n"
"    <p>مع التحية،<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "

#. module: employee_task_management
#: model:mail.template,body_html:employee_task_management.mail_template_task_completed
msgid ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>Dear <t t-out=\"object.manager_id.name or 'Manager'\"></t>,</p>\n"
"    <p>Employee <b><t t-out=\"object.employee_id.name\"></t></b> has marked task list\n"
"       <b><t t-out=\"object.name\"></t></b> as <b>Completed</b>.</p>\n"
"    <p>Please review the progress and close the task list.</p>\n"
"    <p>Regards,<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>عزيزي <t t-out=\"object.manager_id.name or 'Manager'\"></t>،</p>\n"
"    <p>قام الموظف <b><t t-out=\"object.employee_id.name\"></t></b> بوضع علامة على قائمة المهام\n"
"       <b><t t-out=\"object.name\"></t></b> باعتبارها <b>مكتملة</b>.</p>\n"
"    <p>يرجى مراجعة التقدم وإغلاق قائمة المهام.</p>\n"
"    <p>مع التحية،<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "

#. module: employee_task_management
#: model:mail.template,body_html:employee_task_management.mail_template_task_modification_request
msgid ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>Dear <t t-out=\"object.manager_id.name or 'Manager'\"></t>,</p>\n"
"    <p>Employee <b><t t-out=\"object.employee_id.name\"></t></b> has requested a\n"
"       modification on task list <b><t t-out=\"object.name\"></t></b> before\n"
"       accepting it.</p>\n"
"    <t t-if=\"object.modification_reason\">\n"
"        <p><b>Requested change:</b><br><t t-out=\"object.modification_reason\"></t></p>\n"
"    </t>\n"
"    <p>If this request is not handled before the <b>task start date</b>, the\n"
"       task list will be assigned to the employee automatically.</p>\n"
"    <p>Regards,<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333;\">\n"
"    <p>عزيزي <t t-out=\"object.manager_id.name or 'Manager'\"></t>،</p>\n"
"    <p>طلب الموظف <b><t t-out=\"object.employee_id.name\"></t></b> إجراء تعديل\n"
"       على قائمة المهام <b><t t-out=\"object.name\"></t></b> قبل\n"
"       قبولها.</p>\n"
"    <t t-if=\"object.modification_reason\">\n"
"        <p><b>التعديل المطلوب:</b><br><t t-out=\"object.modification_reason\"></t></p>\n"
"    </t>\n"
"    <p>إذا لم تتم معالجة هذا الطلب قبل <b>تاريخ بدء المهمة</b>، فسيتم\n"
"       تعيين قائمة المهام للموظف تلقائيًا.</p>\n"
"    <p>مع التحية،<br><t t-out=\"object.company_id.name\"></t></p>\n"
"</div>\n"
"            "


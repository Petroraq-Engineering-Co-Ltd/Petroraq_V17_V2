<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_unlock_wizard_form" model="ir.ui.view">
        <field name="name">employee.task.unlock.wizard.form</field>
        <field name="model">employee.task.unlock.wizard</field>
        <field name="arch" type="xml">
            <form string="Unlock Closed Task List">
                <div class="alert alert-warning" role="alert">
                    Unlocking a closed task list will move it back to
                    <b>Completed</b> so exceptional edits can be made.
                    This action is recorded in the approval history.
                </div>
                <group>
                    <field name="task_list_id" readonly="1"/>
                    <field name="unlock_reason" required="1"
                           placeholder="Why is this closed record being unlocked?"/>
                </group>
                <footer>
                    <button name="action_confirm_unlock" string="Unlock"
                            type="object" class="btn-danger" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

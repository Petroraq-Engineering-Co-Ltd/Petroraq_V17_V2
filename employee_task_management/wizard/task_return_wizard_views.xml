<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_return_wizard_form" model="ir.ui.view">
        <field name="name">employee.task.return.wizard.form</field>
        <field name="model">employee.task.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Task List">
                <group>
                    <field name="task_list_id" readonly="1"/>
                    <field name="return_reason" required="1"
                           placeholder="Explain what needs to be corrected... (mandatory)"/>
                </group>
                <footer>
                    <button name="action_confirm_return" string="Return Task List"
                            type="object" class="btn-warning" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

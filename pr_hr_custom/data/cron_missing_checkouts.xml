<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_auto_handle_missing_checkouts" model="ir.cron">
            <field name="name">HR Attendance: Auto Handle Missing Checkouts</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_handle_missing_checkouts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <!-- we are subtracting 5 hours from the current time to get the next day's 00:02 AM -->
            <field name="nextcall" eval="(datetime.now().replace(hour=19, minute=2, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
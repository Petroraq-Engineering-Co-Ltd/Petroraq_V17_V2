<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_sale_approval_manager" model="res.groups">
            <field name="name">Sales Approval - Manager</field>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        </record>
        <record id="group_sale_approval_md" model="res.groups">
            <field name="name">Sales Approval - MD / Final Authority</field>
        </record>
        <record id="group_sale_approval_sales" model="res.groups">
            <field name="name">Sales Approval - =Salesman</field>
<!--            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>-->
        </record>
        <record id="group_sale_confirmation_approver" model="res.groups">
            <field name="name">Sales Approval - Sales Order Confirmation</field>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        </record>

        <record id="module_category_sales_created_by_access" model="ir.module.category">
            <field name="name">Sales Created-By Access</field>
            <field name="description">Alternative Sales visibility based on who created the document.</field>
            <field name="sequence">2</field>
        </record>

        <record id="group_sale_created_own" model="res.groups">
            <field name="name">User: Own Created Documents Only</field>
            <field name="category_id" ref="module_category_sales_created_by_access"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="comment">Access Sales documents created by the current user, regardless of the assigned salesperson.</field>
        </record>

        <record id="group_sale_created_all" model="res.groups">
            <field name="name">User: All Created Documents</field>
            <field name="category_id" ref="module_category_sales_created_by_access"/>
            <field name="implied_ids" eval="[(4, ref('group_sale_created_own'))]"/>
            <field name="comment">Access Sales documents created by every user, subject to company access.</field>
        </record>

        <!--
            The custom groups inherit Odoo's standard salesperson group for
            menus and model ACLs. For those users only, switch the standard
            personal domains from assigned salesperson to record creator.
            Users without either custom group keep Odoo's original behavior.
        -->
        <record id="sale.sale_order_personal_rule" model="ir.rule">
            <field name="domain_force">[('create_uid', '=', user.id)] if user.has_group('petroraq_sale_workflow.group_sale_created_own') else ['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        </record>
        <record id="sale.sale_order_line_personal_rule" model="ir.rule">
            <field name="domain_force">[('order_id.create_uid', '=', user.id)] if user.has_group('petroraq_sale_workflow.group_sale_created_own') else ['|', ('salesman_id', '=', user.id), ('salesman_id', '=', False)]</field>
        </record>
        <record id="sale.account_invoice_rule_see_personal" model="ir.rule">
            <field name="domain_force">[('move_type', 'in', ('out_invoice', 'out_refund')), ('create_uid', '=', user.id)] if user.has_group('petroraq_sale_workflow.group_sale_created_own') else [('move_type', 'in', ('out_invoice', 'out_refund')), '|', ('invoice_user_id', '=', user.id), ('invoice_user_id', '=', False)]</field>
        </record>
        <record id="sale.account_invoice_line_rule_see_personal" model="ir.rule">
            <field name="domain_force">[('move_id.move_type', 'in', ('out_invoice', 'out_refund')), ('move_id.create_uid', '=', user.id)] if user.has_group('petroraq_sale_workflow.group_sale_created_own') else [('move_id.move_type', 'in', ('out_invoice', 'out_refund')), '|', ('move_id.invoice_user_id', '=', user.id), ('move_id.invoice_user_id', '=', False)]</field>
        </record>

        <record id="rule_sale_order_created_own" model="ir.rule">
            <field name="name">Sales Orders: Own Created Documents</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sale_created_own'))]"/>
        </record>
        <record id="rule_sale_order_created_all" model="ir.rule">
            <field name="name">Sales Orders: All Created Documents</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sale_created_all'))]"/>
        </record>
        <record id="rule_sale_order_line_created_own" model="ir.rule">
            <field name="name">Sales Order Lines: Own Created Documents</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[('order_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sale_created_own'))]"/>
        </record>
        <record id="rule_sale_order_line_created_all" model="ir.rule">
            <field name="name">Sales Order Lines: All Created Documents</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sale_created_all'))]"/>
        </record>
        <record id="rule_customer_invoice_created_own" model="ir.rule">
            <field name="name">Customer Invoices: Own Created Documents</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[('move_type', 'in', ('out_invoice', 'out_refund')), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sale_created_own'))]"/>
        </record>
        <record id="rule_customer_invoice_created_all" model="ir.rule">
            <field name="name">Customer Invoices: All Created Documents</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[('move_type', 'in', ('out_invoice', 'out_refund'))]</field>
            <field name="groups" eval="[(4, ref('group_sale_created_all'))]"/>
        </record>
        <record id="rule_customer_invoice_line_created_own" model="ir.rule">
            <field name="name">Customer Invoice Lines: Own Created Documents</field>
            <field name="model_id" ref="account.model_account_move_line"/>
            <field name="domain_force">[('move_id.move_type', 'in', ('out_invoice', 'out_refund')), ('move_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sale_created_own'))]"/>
        </record>
        <record id="rule_customer_invoice_line_created_all" model="ir.rule">
            <field name="name">Customer Invoice Lines: All Created Documents</field>
            <field name="model_id" ref="account.model_account_move_line"/>
            <field name="domain_force">[('move_id.move_type', 'in', ('out_invoice', 'out_refund'))]</field>
            <field name="groups" eval="[(4, ref('group_sale_created_all'))]"/>
        </record>

        <!-- Explicit model record to ensure access rights can reference the wizard -->
        <record id="model_sale_order_reject_wizard" model="ir.model">
            <field name="name">sale.order.reject.wizard</field>
            <field name="model">sale.order.reject.wizard</field>
            <field name="transient" eval="True"/>
        </record>
    </data>
</odoo>

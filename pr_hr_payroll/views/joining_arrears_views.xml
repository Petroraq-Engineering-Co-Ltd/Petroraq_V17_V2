<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_payroll_joining_arrears_tree" model="ir.ui.view">
        <field name="name">payroll.joining.arrears.tree</field>
        <field name="model">payroll.joining.arrears</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="calendar_days"/>
                <field name="attendance_based" optional="hide"/>
                <field name="attendance_day_count" optional="hide"/>
                <field name="gross_amount"/>
                <field name="attendance_deduction"/>
                <field name="overtime_amount"/>
                <field name="gosi_employee_deduction" optional="hide"/>
                <field name="net_amount"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-info="state == 'attached'"
                       decoration-muted="state == 'draft'"
                       decoration-danger="state == 'cancel'"/>
            </tree>
        </field>
    </record>

    <record id="view_payroll_joining_arrears_form" model="ir.ui.view">
        <field name="name">payroll.joining.arrears.form</field>
        <field name="model">payroll.joining.arrears</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,attached,paid,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="contract_id" readonly="1"/>
                            <field name="paid_through_date" readonly="1"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="calendar_days" readonly="1"/>
                            <field name="attendance_based" readonly="1"/>
                            <field name="attendance_day_count" readonly="1"
                                   invisible="not attendance_based"/>
                        </group>
                        <group>
                            <field name="gross_amount" readonly="1"/>
                            <field name="attendance_deduction" readonly="1"/>
                            <field name="overtime_amount" readonly="1"/>
                            <field name="gosi_employee_deduction" readonly="1"/>
                            <field name="net_amount" readonly="1"/>
                            <field name="attendance_sheet_id" readonly="1"/>
                            <field name="payslip_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_payroll_joining_arrears" model="ir.actions.act_window">
        <field name="name">Joining Arrears</field>
        <field name="res_model">payroll.joining.arrears</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_payroll_joining_arrears"
              name="Joining Arrears"
              parent="hr_work_entry_contract_enterprise.menu_hr_payroll_root"
              action="action_payroll_joining_arrears"
              sequence="45"
              groups="hr_payroll.group_hr_payroll_user"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pr_it_service_request_reject_wizard_form" model="ir.ui.view">
        <field name="name">pr.it.service.request.reject.wizard.form</field>
        <field name="model">pr.it.service.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject IT Service Request">
                <group><field name="request_id"/><field name="reason" placeholder="Explain why the request is being rejected."/></group>
                <footer><button name="action_reject" string="Reject" type="object" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
</odoo>

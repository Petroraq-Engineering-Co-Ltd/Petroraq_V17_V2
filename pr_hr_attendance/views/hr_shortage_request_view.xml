<odoo>

    <record id="hr_shortage_request_filter_view" model="ir.ui.view">
        <field name="name">pr.hr.shortage.request.filter.view</field>
        <field name="model">pr.hr.shortage.request</field>
        <field name="arch" type="xml">
            <search string="Shortage Request">
                <field name="name"/>
                <field name="request_type"/>
                <filter domain="[('request_type','=','no_punch')]"
                        string="No Punch Records" name="no_punch"/>
                <filter domain="[('state', '=', 'draft')]"
                        string="Draft" name="draft"/>
                <filter domain="[('state', '=', 'employee_manager_approval')]"
                        string="To Dept. Manager Approve" name="manager_approve"/>
                <filter domain="[('state', '=', 'hr_supervisor_approval')]"
                        string="To HR Supervisor Approve" name="hr_supervisor_approve"/>
                <filter domain="[('state', '=', 'hr_manager_approval')]"
                        string="To HR Manager Approve" name="hr_manager_approve"/>
                <filter domain="[('state', '=', 'md_approval')]"
                        string="To MD Approve" name="md_approve"/>
                <filter string="Approved"
                        domain="[('state', '=', 'approved')]" name="approved"/>
                <filter string="Rejected"
                        domain="[('state', '=', 'rejected')]" name="rejected"/>
                <separator/>
                <separator/>
                <field name="employee_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee"
                            context="{'group_by':'employee_id'}"/>
                    <separator/>
                    <filter name="group_date" string="Date"
                            context="{'group_by':'date'}"/>
                    <separator/>
                    <filter name="group_state" string="Status"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_shortage_request_form_view" model="ir.ui.view">
        <field name="name">pr.hr.shortage.request.form.view</field>
        <field name="model">pr.hr.shortage.request</field>
        <field name="arch" type="xml">
            <form string="Shortage Request">
                <field name="can_select_employee" invisible="1"/>
                <field name="can_submit" invisible="1"/>
                <field name="can_manager_approve" invisible="1"/>
                <field name="can_hr_supervisor_approve" invisible="1"/>
                <field name="can_hr_manager_approve" invisible="1"/>
                <field name="can_md_approve" invisible="1"/>
                <field name="can_reject" invisible="1"/>
                <field name="can_reset_rejection" invisible="1"/>
                <field name="can_reset_to_draft" invisible="1"/>
                <field name="payroll_finalized" invisible="1"/>
                <header>
                    <button name="action_submit" string="Submit" class="btn-primary"
                            invisible="not can_submit"
                            type="object"/>
                    <button name="action_manager_approve" string="Dept. Manager Approve" class="btn-success"
                            invisible="not can_manager_approve"
                            type="object"/>
                    <button name="action_hr_supervisor_approve" string="HR Supervisor Approve" class="btn-success"
                            invisible="not can_hr_supervisor_approve"
                            groups="pr_hr.group_hr_supervisor"
                            type="object"/>
                    <button name="action_hr_manager_approve" string="HR Manager Approve" class="btn-success"
                            invisible="not can_hr_manager_approve"
                            groups="pr_hr.group_hr_manager"
                            type="object"/>
                    <button name="action_md_approve" string="MD Approve" class="btn-success"
                            invisible="not can_md_approve"
                            groups="pr_hr.group_hr_md"
                            type="object"/>
                    <button name="action_reject" string="Reject" class="btn-danger"
                            invisible="not can_reject"
                            type="object"/>
                    <button name="action_reset_rejection" string="Reset Rejection" class="btn-warning"
                            invisible="not can_reset_rejection"
                            confirm="Reset this rejection and reopen your decision stage?"
                            type="object"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" class="btn-secondary"
                            invisible="not can_reset_to_draft"
                            type="object"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,employee_manager_approval,hr_supervisor_approval,hr_manager_approval,md_approval,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Rejected" bg_color="bg-danger"
                            invisible="state != 'rejected'"/>
                    <div class="alert alert-warning" role="alert" invisible="not payroll_finalized">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        The attendance sheet of this day is already final. Approving this request updates the
                        attendance, but does not recalculate that sheet or its payslip.
                    </div>
                    <div class="oe_button_box" name="button_box">

                    </div>
                    <div class="oe_title" >
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"
                                   readonly="1" force_save="1"
                            />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_type" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="state != 'draft' or not can_select_employee" force_save="1" string="Employee" options="{'no_create': True, 'no_edit': True}"/>
                            <field name="check_in" string="Actual Check In" readonly="state != 'draft'" required="request_type == 'no_punch'"/>
                            <field name="check_out" string="Actual Check Out" readonly="state != 'draft'" required="request_type == 'no_punch'"/>
                            <field name="date" readonly="state != 'draft'" string="Date"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="state != 'draft' or not can_select_employee" force_save="1" string="Company" options="{'no_create': True, 'no_edit': True}"/>
                            <field name="employee_manager_id" options="{'no_create': True, 'no_edit': True}" invisible="1"/>
                            <field name="hr_supervisor_ids" options="{'no_create': True, 'no_edit': True}" widget="many2many_tags" invisible="1"/>
                            <field name="hr_manager_ids" options="{'no_create': True, 'no_edit': True}" widget="many2many_tags" invisible="1"/>
                            <field name="shortage_time"/>
                            <field name="employee_reason" readonly="state != 'draft'" required="1"/>
                            <field name="manager_approved_user_id" invisible="not manager_approved_user_id"/>
                            <field name="manager_approved_date" invisible="not manager_approved_date"/>
                            <field name="hr_supervisor_approved_user_id" invisible="not hr_supervisor_approved_user_id"/>
                            <field name="hr_supervisor_approved_date" invisible="not hr_supervisor_approved_date"/>
                            <field name="hr_manager_approved_user_id" invisible="not hr_manager_approved_user_id"/>
                            <field name="hr_manager_approved_date" invisible="not hr_manager_approved_date"/>
                            <field name="md_approved_user_id" invisible="not md_approved_user_id"/>
                            <field name="md_approved_date" invisible="not md_approved_date"/>
                            <field name="reject_reason" invisible="state != 'rejected'"/>
                            <field name="rejected_stage" invisible="state != 'rejected' or not rejected_stage"/>
                            <field name="rejected_by_user_id" invisible="state != 'rejected' or not rejected_by_user_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>


    <record id="hr_shortage_request_tree_view" model="ir.ui.view">
        <field name="name">pr.hr.shortage.request.tree.view</field>
        <field name="model">pr.hr.shortage.request</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="name"/>
                <field name="request_type"/>
                <field name="employee_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="date"/>
                <field name="employee_reason"/>
                <field name="company_id"/>
                <field name="employee_manager_id" column_invisible="1"/>
                <field name="hr_supervisor_ids" widget="many2many_tags" column_invisible="1"/>
                <field name="hr_manager_ids" widget="many2many_tags" column_invisible="1"/>
                <field name="state" widget="badge"
                    decoration-muted="state == 'draft'"
                    decoration-danger="state == 'rejected'"
                    decoration-warning="state in ('employee_manager_approval', 'hr_supervisor_approval')"
                    decoration-success="state == 'approved'"
                    decoration-info="state in ('hr_manager_approval', 'md_approval')"/>

            </tree>
        </field>
    </record>


    <record id="action_hr_shortage_request_action" model="ir.actions.act_window">
        <field name="name">Shortage Requests</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pr.hr.shortage.request</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('pr_hr_attendance.hr_shortage_request_tree_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('pr_hr_attendance.hr_shortage_request_form_view')})]"/>
        <field name="search_view_id" ref="hr_shortage_request_filter_view"/>
    </record>


    <menuitem id="menu_hr_hr_shortage_request"
              name="Shortage Requests"
              parent="menu_main_hr_attendance_notification"
              sequence="2"
              action="action_hr_shortage_request_action"/>


</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- HR Manager gets the same access in attendance_mode_security.xml -->
    <record id="pr_hr.group_hr_supervisor" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('de_hr_workspace.group_hr_employee_approvals'))]"/>
    </record>

    <record id="de_hr_workspace.hr_approvals_menu_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('pr_hr.group_hr_supervisor'))]"/>
    </record>

    <record id="rule_shortage_request_pr_hr_approvers" model="ir.rule">
        <field name="name">Shortage Request: HR Supervisor, HR Manager and MD</field>
        <field name="model_id" ref="model_pr_hr_shortage_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('pr_hr.group_hr_supervisor')), (4, ref('pr_hr.group_hr_manager')), (4, ref('pr_hr.group_hr_md'))]"/>
    </record>

    <!-- Attendance staff see every request of their companies, but only
         create and edit the ones they enter themselves. -->
    <record id="rule_shortage_request_attendance_officer_read" model="ir.rule">
        <field name="name">Shortage Request: attendance staff read</field>
        <field name="model_id" ref="model_pr_hr_shortage_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
    </record>

    <record id="rule_shortage_request_attendance_officer_write" model="ir.rule">
        <field name="name">Shortage Request: attendance staff own entries</field>
        <field name="model_id" ref="model_pr_hr_shortage_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
    </record>
</odoo>

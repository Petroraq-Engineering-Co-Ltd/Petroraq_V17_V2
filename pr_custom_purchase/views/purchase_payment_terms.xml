<odoo>
    <record id="purchase_payment_term_milestones" model="ir.ui.view">
        <field name="name">account.payment.term.purchase.milestones</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Purchase Milestone Breakdown">
                    <field name="purchase_milestone_schedule"/>
                    <group invisible="not purchase_milestone_schedule">
                        <field name="advance_percent"/>
                        <field name="progressive_percent"/>
                        <field name="completion_percent"/>
                        <field name="purchase_credit_days"/>
                    </group>
                    <div class="text-muted" invisible="not purchase_milestone_schedule">
                        This breakdown is printed on the PO and used to classify payments.
                        Configure the standard due-date calculation lines separately;
                        progress and completion milestones are not automatic calendar dates.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
    <record id="purchase_payment_stage_form" model="ir.ui.view">
        <field name="name">account.payment.purchase.stage</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="PO Payment Tracking" invisible="not purchase_order_id">
                    <field name="purchase_order_id" readonly="1"/>
                    <field name="purchase_payment_term_id"/>
                    <field name="purchase_payment_stage"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

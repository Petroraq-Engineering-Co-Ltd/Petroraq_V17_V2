<odoo>
    <record id="view_purchase_order_form_inherit_send_email" model="ir.ui.view">
        <field name="name">purchase.order.form.send.email</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/*[1]" position="before">
                <button name="action_send_purchase_order_email"
                        string="Send Email"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ('draft','sent')"
                        groups="pr_custom_purchase.procurement_admin"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_form_workflow_billing_status" model="ir.ui.view">
        <field name="name">purchase.order.form.workflow.billing.status</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='other_info']/field[@name='origin']" position="after">
                <field name="workflow_delivery_status" widget="badge"
                       decoration-success="workflow_delivery_status == 'done'"
                       decoration-warning="workflow_delivery_status == 'partial'"
                       decoration-info="workflow_delivery_status == 'pending'"
                       decoration-muted="workflow_delivery_status in ('not_ordered', 'cancel')"/>
                <field name="workflow_billing_status"
                       string="Billing Status"
                       widget="badge"
                       invisible="state in ('draft', 'sent', 'cancel')"
                       decoration-success="workflow_billing_status == 'billed'"
                       decoration-info="workflow_billing_status == 'waiting'"
                       decoration-warning="workflow_billing_status == 'partial'"
                       decoration-muted="workflow_billing_status == 'nothing'"/>
                <field name="workflow_payment_status"
                       string="Payment Status"
                       widget="badge"
                       invisible="state in ('draft', 'sent', 'cancel')"
                       decoration-success="workflow_payment_status in ('paid', 'advance_paid')"
                       decoration-info="workflow_payment_status == 'in_payment'"
                       decoration-warning="workflow_payment_status in ('partial', 'advance_partial')"
                       decoration-danger="workflow_payment_status in ('not_paid', 'reversed')"
                       decoration-muted="workflow_payment_status == 'no_bill'"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_tree_workflow_billing_status" model="ir.ui.view">
        <field name="name">purchase.order.tree.workflow.billing.status</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="workflow_delivery_status" widget="badge"
                       decoration-success="workflow_delivery_status == 'done'"
                       decoration-warning="workflow_delivery_status == 'partial'"
                       decoration-info="workflow_delivery_status == 'pending'"
                       decoration-muted="workflow_delivery_status in ('not_ordered', 'cancel')"/>
                <field name="workflow_billing_status" string="Billing Status" widget="badge" optional="show"
                       decoration-success="workflow_billing_status == 'billed'"
                       decoration-info="workflow_billing_status == 'waiting'"
                       decoration-warning="workflow_billing_status == 'partial'"
                       decoration-muted="workflow_billing_status == 'nothing'"/>
                <field name="workflow_payment_status" string="Payment Status" widget="badge" optional="show"
                       decoration-success="workflow_payment_status in ('paid', 'advance_paid')"
                       decoration-info="workflow_payment_status == 'in_payment'"
                       decoration-warning="workflow_payment_status in ('partial', 'advance_partial')"
                       decoration-danger="workflow_payment_status in ('not_paid', 'reversed')"
                       decoration-muted="workflow_payment_status == 'no_bill'"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_form_inherit_hide_send_by_email" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.hide.send.by_email</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/button[@name='action_rfq_send'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//form/header/button[@name='action_rfq_send'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_inherit_reason_tab" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.reason.tab</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Reason" name="reason">
                    <group>
                        <field name="rejection_reason"
                               placeholder="Enter Reason for Rejection"
                               readonly="state != 'pending'"
                               groups="pr_custom_purchase.project_engineer,pr_custom_purchase.project_manager,pr_custom_purchase.operations_director,pr_custom_purchase.managing_director"/>
                        <field name="rejection_reason"
                               readonly="1"
                               placeholder="Enter Reason for Rejection"
                               groups="pr_custom_purchase.procurement_admin"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_inherit_rfq_quotation_actions" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.rfq.quotation.actions</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="quotation_count" invisible="1"/>
                <field name="requisition_id" invisible="1"/>
                <field name="requisition_count" invisible="1"/>
                <field name="source_rfq_count" invisible="1"/>
            </xpath>
            <xpath expr="//form/header" position="inside">
                <field name="is_rfq_record" invisible="1"/>
                <field name="can_create_po_from_rfq" invisible="1"/>
                <button name="action_create_po_from_rfq"
                        type="object"
                        string="Create PO"
                        class="btn-primary"
                        groups="pr_custom_purchase.procurement_admin"
                        invisible="not can_create_po_from_rfq"/>
                <button name="action_open_rfq_comparison"
                        type="object"
                        string="Compare RFQs"
                        class="btn-secondary"
                        groups="pr_custom_purchase.procurement_admin"
                        invisible="1"/>
            </xpath>
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button type="object"
                        class="oe_stat_button"
                        name="action_view_source_requisition"
                        icon="fa-file-text-o"
                        invisible="not requisition_id">
                    <field name="requisition_count" widget="statinfo" string="PR"/>
                </button>
                <button type="object"
                        class="oe_stat_button"
                        name="action_view_source_rfq"
                        icon="fa-envelope-open-o"
                        invisible="source_rfq_count == 0">
                    <field name="source_rfq_count" widget="statinfo" string="RFQ"/>
                </button>
                <button type="object"
                        class="oe_stat_button"
                        name="action_view_rfq_quotations"
                        icon="fa-list-alt"
                        invisible="state not in ('draft','sent')">
                    <field name="quotation_count" widget="statinfo" string="RFQs"/>
                </button>
            </xpath>
        </field>
    </record>
    <record id="view_purchase_order_search_workflow_reporting" model="ir.ui.view">
        <field name="name">purchase.order.search.workflow.reporting</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="budget_remaining_amount" string="Budget Remaining"/>
                <field name="approval_status" string="Approval"/>
                <field name="workflow_billing_status" string="Billing Status"/>
                <field name="workflow_payment_status" string="Payment Status"/>
                <field name="workflow_delivery_status"/>
                <separator/>
                <filter name="po_budget_available" string="Budget Available" domain="[('budget_remaining_amount', '&gt;', 0)]"/>
                <filter name="po_budget_exhausted" string="Budget Exhausted / Overrun" domain="[('budget_remaining_amount', '&lt;=', 0)]"/>
                <separator/>
                <filter name="po_approval_pending" string="Approval Pending" domain="[('approval_status', 'in', ['pending_pe', 'pending_pm', 'pending_od', 'pending_md'])]"/>
                <filter name="po_approval_approved" string="Approved" domain="[('approval_status', '=', 'approved')]"/>
                <filter name="po_approval_rejected" string="Rejected" domain="[('approval_status', '=', 'rejected')]"/>
                <separator/>
                <filter name="po_billing_waiting" string="Waiting for Bills" domain="[('workflow_billing_status', '=', 'waiting')]"/>
                <filter name="po_billing_partial" string="Partially Billed" domain="[('workflow_billing_status', '=', 'partial')]"/>
                <filter name="po_billing_full" string="Fully Billed" domain="[('workflow_billing_status', '=', 'billed')]"/>
                <separator/>
                <filter name="po_payment_advance" string="Advance Paid" domain="[('workflow_payment_status', 'in', ['advance_partial', 'advance_paid'])]"/>
                <filter name="po_payment_unpaid" string="Not Paid" domain="[('workflow_payment_status', '=', 'not_paid')]"/>
                <filter name="po_payment_partial" string="Partially Paid" domain="[('workflow_payment_status', '=', 'partial')]"/>
                <filter name="po_payment_processing" string="Payment In Process" domain="[('workflow_payment_status', '=', 'in_payment')]"/>
                <filter name="po_payment_paid" string="Fully Paid" domain="[('workflow_payment_status', '=', 'paid')]"/>
            </xpath>
        </field>
    </record>
</odoo>

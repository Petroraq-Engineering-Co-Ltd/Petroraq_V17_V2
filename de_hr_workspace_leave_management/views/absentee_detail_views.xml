<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_leave_absentee_detail_tree" model="ir.ui.view">
        <field name="name">de.hr.leave.absentee.detail.tree</field>
        <field name="model">de.hr.leave.absentee.detail</field>
        <field name="arch" type="xml">
            <tree string="Absentees" create="0" edit="0" delete="0" decoration-danger="reason">
                <field name="absence_date"/>
                <field name="day_name"/>
                <field name="employee_code"/>
                <field name="employee_id"/>
                <field name="department"/>
                <field name="job_position"/>
                <field name="first_check_in"/>
                <field name="reason"/>
                <field name="expected_shift"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_leave_absentee_detail_form" model="ir.ui.view">
        <field name="name">de.hr.leave.absentee.detail.form</field>
        <field name="model">de.hr.leave.absentee.detail</field>
        <field name="arch" type="xml">
            <form string="Absentee Detail" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="absence_date"/>
                            <field name="day_name"/>
                            <field name="employee_id"/>
                            <field name="employee_code"/>
                        </group>
                        <group>
                            <field name="department"/>
                            <field name="job_position"/>
                            <field name="first_check_in"/>
                            <field name="reason"/>
                            <field name="expected_shift"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

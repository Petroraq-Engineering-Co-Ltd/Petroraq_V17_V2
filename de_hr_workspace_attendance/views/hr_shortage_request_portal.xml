<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_employee_shortage_requests" name="Employee Shortage Requests" customize_show="True"
              inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_employee_user" t-value="request.env['hr.employee'].sudo().search_count([('user_id', '=', request.env.user.id), ('active', '=', True)])"/>
            <t t-if="portal_employee_user" t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-if="portal_employee_user" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/de_hr_workspace_attendance/static/src/img/shortage_request_portal.svg'"/>
                <t t-set="title">Shortage Requests</t>
                <t t-set="url" t-value="'/my/shortage_requests'"/>
                <t t-set="text">Follow your shortage requests</t>
                <t t-set="placeholder_count" t-value="'my_shortage_request_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_my_shortage_requests" name="My Shortage Requests">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Shortage Requests</t>
            </t>
            <div t-if="request.env.user.has_group('base.group_user')" class="mb-3 text-end">
                <a href="/shortage_request" class="btn btn-primary">Request Attendance Correction</a>
            </div>
            <div t-if="not shortage_requests" class="alert alert-warning" role="alert">
                There are no shortage requests.
            </div>
            <t t-if="shortage_requests" t-call="portal.portal_table">
                <thead>
                    <tr class="active" style="background-color: #009879;color: #ffffff;">
                        <th>Request</th>
                        <th>Request Type</th>
                        <th>Date</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="shortage_requests" t-as="shortage_request">
                        <td><span t-field="shortage_request.name"/></td>
                        <td><span t-field="shortage_request.request_type"/></td>
                        <td><span t-field="shortage_request.date"/></td>
                        <td><span t-field="shortage_request.check_in"/></td>
                        <td><span t-field="shortage_request.check_out"/></td>
                        <td><span t-field="shortage_request.employee_reason"/></td>
                        <td><span class="badge text-bg-secondary" t-field="shortage_request.approval_state"/></td>
                        <td><span t-field="shortage_request.reject_reason"/></td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>
</odoo>

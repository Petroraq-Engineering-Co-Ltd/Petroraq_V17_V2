<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_employee_shortage_requests_approvals" name="Employee Shortage Requests Approvals"
              customize_show="True"
              inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_employee_user" t-value="request.env['hr.employee'].sudo().search_count([('user_id', '=', request.env.user.id), ('active', '=', True)])"/>
            <t t-if="portal_employee_user" t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-if="portal_employee_user" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/de_hr_workspace_attendance/static/src/img/shortage_request_approval.png'"/>
                <t t-set="title">Shortage Requests Approvals</t>
                <t t-set="url" t-value="'/my/shortage_requests_approval'"/>
                <t t-set="text">Follow your employee's shortage requests</t>
                <t t-set="placeholder_count" t-value="'my_shortage_request_approval_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_my_shortage_requests_approvals" name="Employees Shortage Requests Approvals">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Shortage Requests Approvals</t>
            </t>
            <t t-if="not shortage_requests_approvals">
                <div class="alert alert-warning" role="alert">
                    There are no shortage requests needing approval.
                </div>
            </t>
            <t t-if="shortage_requests_approvals">
                <t t-call="portal.portal_table">
                    <t t-set="loop_cycle_number" t-value="0"/>
                    <thead>
                        <tr class="active" style="background-color: #009879;color: #ffffff;">
                            <th>Employee</th>
                            <th>Request Type</th>
                            <th>Date</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Shortage Time</th>
                            <th>Employee Reason</th>
                            <th colspan="2">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="shortage_requests_approvals" t-as="shortage_request"
                            t-att-style="'background-color: #ffffff' if loop_cycle_number % 2 == 0 else 'background-color: #f2f2f2;color: #009879;'">
                            <t t-set="loop_cycle_number" t-value="loop_cycle_number + 1"/>
                            <td>
                                <span t-esc="shortage_request.employee_id.name"/>
                            </td>
                            <td>
                                <span t-field="shortage_request.request_type"/>
                            </td>
                            <td>
                                <span t-field="shortage_request.date" t-options="{'widget': 'date'}"/>
                            </td>
                            <td>
                                <span t-field="shortage_request.check_in"/>
                            </td>
                            <td>
                                <span t-field="shortage_request.check_out"/>
                            </td>
                            <td>
                                <span t-field="shortage_request.shortage_time"/>
                            </td>
                            <td>
                                <span t-field="shortage_request.employee_reason"/>
                            </td>
                            <td>
                                <span t-field="shortage_request.approval_state"
                                      style="color: #fff !important;background-color: #008080 !important;border-color: #008080 !important;border-radius: 8px !important;padding: 6px !important;"/>
                            </td>
                            <td>
                                <button class="btn-info" icon="fa-eye">
                                    <a t-attf-href="/my/shortage_requests_approval/#{shortage_request.id}">Action</a>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </t>
            </t>
        </t>
    </template>

    <template id="portal_shortage_request_approval_page" name="Employee Shortage Request Approval">
        <t t-call="portal.portal_layout">
            <section class="w-100 px-4 py-5" style="background-color: #9de2ff; border-radius: .5rem .5rem 0 0;">
                <div class="row d-flex justify-content-center">
                    <div class="col col-md-9 col-lg-9 col-xl-9">
                        <div class="card" style="border-radius: 15px;">
                            <div class="card-body p-4">
                                <h5 class="mb-1">
                                    <span t-esc="shortage_request.employee_id.name"/>
                                    <span class="badge text-bg-secondary ms-2" t-field="shortage_request.approval_state"/>
                                </h5>
                                <p class="mb-3 text-muted">
                                    <span t-esc="shortage_request.employee_id.job_id.name"/>
                                </p>
                                <div class="row mb-3">
                                    <div class="col-md-3">
                                        <p class="small text-muted mb-1">Request Type</p>
                                        <span t-field="shortage_request.request_type"/>
                                    </div>
                                    <div class="col-md-3">
                                        <p class="small text-muted mb-1">Date</p>
                                        <span t-field="shortage_request.date"/>
                                    </div>
                                    <div class="col-md-3">
                                        <p class="small text-muted mb-1">Check-In</p>
                                        <span t-if="shortage_request.check_in" t-field="shortage_request.check_in"
                                              t-options="{'widget': 'datetime', 'tz_name': tz_name}"/>
                                    </div>
                                    <div class="col-md-3">
                                        <p class="small text-muted mb-1">Check-Out</p>
                                        <span t-if="shortage_request.check_out" t-field="shortage_request.check_out"
                                              t-options="{'widget': 'datetime', 'tz_name': tz_name}"/>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <p class="small text-muted mb-1">Shortage Time</p>
                                        <span t-esc="shortage_request.shortage_time or '-'"/>
                                    </div>
                                    <div class="col-md-6">
                                        <p class="small text-muted mb-1">Employee Reason</p>
                                        <span t-esc="shortage_request.employee_reason or '-'"/>
                                    </div>
                                </div>
                                <div t-if="shortage_request.scheduled_check_in" class="alert alert-info" role="alert">
                                    Final approval sets this attendance to the scheduled shift:
                                    <span t-field="shortage_request.scheduled_check_in"
                                          t-options="{'widget': 'datetime', 'tz_name': tz_name}"/>
                                    -
                                    <span t-field="shortage_request.scheduled_check_out"
                                          t-options="{'widget': 'datetime', 'tz_name': tz_name}"/>
                                </div>
                                <div t-if="shortage_request.payroll_finalized" class="alert alert-warning" role="alert">
                                    The attendance sheet of this day is already final. Approving this request updates
                                    the attendance, but does not recalculate that sheet or its payslip.
                                </div>
                                <div t-if="error_message" class="alert alert-danger" role="alert">
                                    <span t-esc="error_message"/>
                                </div>
                                <div t-if="shortage_request.state == 'employee_manager_approval'" class="row">
                                    <div class="col-md-4">
                                        <form t-attf-action="/my/shortage_requests_approved/#{shortage_request.id}" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-info w-100">
                                                <i class="fa fa-check-circle"/> Approve
                                            </button>
                                        </form>
                                    </div>
                                    <div class="col-md-8">
                                        <form t-attf-action="/my/shortage_requests_rejected/#{shortage_request.id}" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <textarea name="reject_reason" class="form-control mb-2" rows="2" required="required"
                                                      placeholder="Reason for rejection"/>
                                            <button type="submit" class="btn btn-outline-danger w-100">
                                                <i class="fa fa-times"/> Reject
                                            </button>
                                        </form>
                                    </div>
                                </div>
                                <div t-if="shortage_request.state == 'rejected' and shortage_request.can_reset_rejection"
                                     class="text-center">
                                    <p class="text-danger mb-3">
                                        <strong>Rejected:</strong>
                                        <span t-esc="shortage_request.reject_reason"/>
                                    </p>
                                    <form t-attf-action="/my/shortage_requests_reset_rejection/#{shortage_request.id}" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-warning">
                                            Reset Rejection and Decide Again
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <div class="container py-5">
                <h1>Chatter feature</h1>
                <t t-call="portal.message_thread">
                    <t t-set="object" t-value="shortage_request"/>
                </t>
            </div>
        </t>
    </template>
</odoo>

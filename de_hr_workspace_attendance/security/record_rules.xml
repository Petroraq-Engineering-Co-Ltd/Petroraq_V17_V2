<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="hr_attendance_workspace_rule_employee" model="ir.rule">
            <field name="name">Attendance Workspace</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4,ref('de_hr_workspace.group_hr_employee_workspace'))]"/>
        </record>
        <record id="hr_shortage_request_workspace_rule_employee" model="ir.rule">
            <field name="name">Own Attendance Correction Requests and Team Approvals</field>
            <field name="model_id" ref="pr_hr_attendance.model_pr_hr_shortage_request"/>
            <field name="domain_force">['|', '|', '|', ('employee_id.user_id', '=', user.id), ('employee_manager_id.user_id', '=', user.id), ('hr_supervisor_ids', 'in', user.id), ('hr_manager_ids', 'in', user.id)]</field>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4,ref('de_hr_workspace.group_hr_employee_workspace'))]"/>
        </record>
    </data>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_shortage_request_wizard_view_form" model="ir.ui.view">
        <field name="name">pr.hr.shortage.request.wizard.form</field>
        <field name="model">pr.hr.shortage.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Shortage Request">
                <field name="attendance_id" invisible="1"/>
                <field name="payroll_finalized" invisible="1"/>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not payroll_finalized">
                        <i class="fa fa-exclamation-triangle me-1" title="Warning"/>
                        The attendance sheet of this day is already final. Approving this request updates the
                        attendance, but does not recalculate that sheet or its payslip.
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                        </group>
                        <group>
                            <field name="shortage_time"/>
                            <field name="scheduled_check_in"/>
                            <field name="scheduled_check_out"/>
                        </group>
                    </group>
                    <group>
                        <field name="employee_reason" placeholder="Why were your hours short?"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

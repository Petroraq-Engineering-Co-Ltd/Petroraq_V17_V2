<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_vendor_srn" model="ir.actions.report">
        <field name="name">Service Receipt Note</field>
        <field name="model">service.receipt.note</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pr_vendor_customer_portal.report_vendor_srn_document</field>
        <field name="report_file">pr_vendor_customer_portal.report_vendor_srn_document</field>
        <field name="print_report_name">'SRN - %s' % (object.name)</field>
    </record>

    <template id="report_vendor_srn_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Service Receipt Note: <span t-field="o.name"/></h2>
                        <div class="row mb-3">
                            <div class="col-6"><strong>Purchase Order: </strong><span t-field="o.purchase_id"/></div>
                            <div class="col-6"><strong>Receipt Date: </strong><span t-field="o.date"/></div>
                            <div class="col-6"><strong>Vendor: </strong><span t-field="o.partner_id"/></div>
                            <div class="col-6"><strong>Approval: </strong><span t-field="o.approval_state"/></div>
                        </div>
                        <table class="table table-sm o_main_table">
                            <thead><tr><th>Product</th><th>Description</th><th class="text-end">Ordered</th><th class="text-end">Accepted</th><th>UoM</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.product_id"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.ordered_qty"/></td>
                                    <td class="text-end"><span t-field="line.done_qty"/></td>
                                    <td><span t-field="line.uom_id"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

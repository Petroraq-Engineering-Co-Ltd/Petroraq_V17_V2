@font-face {font-family: InvoiceArabic; src: url('/pr_tax_Invoice_report_custom/static/src/font/droid-arabic-naskh-regular/Droid%20Arabic%20Naskh%20Regular/Droid%20Arabic%20Naskh%20Regular.ttf') format('truetype');}
.pr-invoice {font-family: InvoiceArabic, Arial, sans-serif; font-size: 14px; color: #111;}
.pr-invoice table {width:100%; border-collapse:collapse; table-layout:fixed;}
.pr-invoice td, .pr-invoice th {padding:5px; vertical-align:top; line-height:1.4; word-wrap:break-word;}
.pr-invoice .invoice-heading {text-align:center; font-size:21px; margin:0 0 12px;}
.pr-invoice .invoice-info {margin-bottom:14px; page-break-inside:avoid;}
.pr-invoice .o_pr_invoice_lines {font-size:14px; margin-bottom:12px;}
.pr-invoice .o_pr_invoice_lines thead {display:table-header-group;}
.pr-invoice .o_pr_invoice_lines th {background:#edf0f5; text-align:center; border:1px solid #555;}
.pr-invoice .o_pr_invoice_lines td {border:1px solid #777; text-align:right;}
.pr-invoice .o_pr_invoice_lines tr {page-break-inside:avoid;}
.pr-invoice .o_pr_invoice_lines .description {text-align:left;}
.pr-invoice .description span {white-space:pre-line;}
.pr-invoice .section-row td {background:#f0f0f0; text-align:left; font-weight:bold;}
.pr-invoice .note-row td {text-align:left; font-style:italic;}
.pr-invoice .o_pr_invoice_totals_table {font-size:14px; margin-top:12px; page-break-inside:avoid;}
.pr-invoice .o_pr_invoice_words_table {font-size:12px; page-break-inside:avoid;}
.pr-invoice .o_pr_invoice_qr_block {margin:12px 0; text-align:center; page-break-inside:avoid;}
.pr-invoice .o_pr_invoice_qr_block img {width:120px; height:120px;}
.pr-invoice .invoice-terms {margin-top:14px; font-size:12px;}
</style>

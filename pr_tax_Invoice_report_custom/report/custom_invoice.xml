                            </tr>
                            <tr>
                                <td width="35%" style="border:1px solid #000000;"><t t-out="'Credit Total' if report_values['is_refund'] else 'Invoice Total'"/></td>
                                <td width="23%" style="text-align:center;border:1px solid #000000">
                                    <span t-esc="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                                <td width="42%" style="text-align:right;border:1px solid #000000">
                                                                إجمالي المبلغ المستحق
                                                            </td>
                            </tr>
                            <t t-set="fixed_payable" t-value="o.amount_total - (o.retention_deduct_amount or 0.0)"/>
                            <tr t-if="not o.currency_id.is_zero(o.retention_deduct_amount or 0.0)">
                                <td width="35%" style="border:1px solid #000000;">
                                                                Retention
                                                                <span t-if="o.retention_percent">
                                                                    (
                                                                    <t t-esc="('%g' % (o.retention_percent or 0.0))"/>%
                                                                    )
                                                                </span>
                                </td>
                                <td width="23%" style="text-align:center;border:1px solid #000000">
                                    <span>
                                                                    -
                                                                    <t t-esc="abs(o.retention_deduct_amount)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                    </span>
                                </td>
                                <td width="42%" style="text-align:right;border:1px solid #000000">
                                    <span t-if="o.retention_percent">
                                        <span dir="ltr">
                                                                        (
                                                                        <t t-esc="('%g' % (o.retention_percent or 0.0))             .translate(str.maketrans('0123456789','٠١٢٣٤٥٦٧٨٩'))"/>
                                                                        ٪
                                                                        )
                                                                    </span>
                                    </span>
                                                                خصم الاستبقاء

                                                            </td>
                            </tr>
                            <tr t-if="not o.currency_id.is_zero(o.retention_deduct_amount or 0.0)">
                                <td width="35%" style="border:1px solid #000000;">Payable after retention</td>
                                <td width="23%" style="text-align:center;border:1px solid #000000">
                                    <span t-esc="fixed_payable" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                                <td width="42%" style="text-align:right;border:1px solid #000000">
                                                                إجمالي المبلغ المستحق
                                                            </td>
                            </tr>
                        </table>
                        <table class="table table-border o_pr_invoice_words_table" style="width:100%;font-size:12px;">
                            <tr>
                                <td style="border-left:1px solid black;border-right: none;text-align:left;">
                                    <span t-esc="o.amount_to_text(fixed_payable) if o.currency_id.name == 'SAR' else o.currency_id.amount_to_text(fixed_payable)"/>
                                </td>
                                <td style="border-right:1px solid black;border-left: none;text-align:right">
                                    <span t-esc="o.amount_to_world(fixed_payable) if o.currency_id.name == 'SAR' else ''"/>
                                </td>
                            </tr>
                        </table>
                        <div class="o_pr_invoice_qr_block">
                            <span class="o_pr_invoice_qr_cell">
                                <img t-if="o.state == 'posted' and o.l10n_sa_qr_code_str" t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', quote_plus(o.l10n_sa_qr_code_str), 200, 200)"/>
                            </span>
                        </div>
                        <div class="invoice-terms" t-if="not is_html_empty(o.narration)">
                            <span t-field="o.narration"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

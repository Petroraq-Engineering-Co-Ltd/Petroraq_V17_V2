<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="paperformat_petroraq_invoice_report_sheet" model="report.paperformat">
        <field name="name">Petroraq Tax Invoice Report</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">370</field>
        <field name="page_width">250</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">55</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">95</field>
    </record>
    <record id="petroraq_invoice_report_action_id" model="ir.actions.report">
        <field name="name">Petroraq Tax Invoice Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pr_tax_Invoice_report_custom.petroraq_invoice_report_temp_id</field>
        <field name="report_file">pr_tax_Invoice_report_custom.petroraq_invoice_report_temp_id</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="pr_tax_Invoice_report_custom.paperformat_petroraq_invoice_report_sheet"/>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice')),  (4, ref('account.group_account_readonly'))]"/>
    </record>

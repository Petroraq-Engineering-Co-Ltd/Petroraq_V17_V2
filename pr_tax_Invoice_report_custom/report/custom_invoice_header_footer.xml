<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--Bridge template-->
    <template id="custom_invoice_bridge_layout">
        <style>
            .header, .footer {
                margin: 0 !important;
                padding: 0 !important;
            }
        </style>
        <!-- Multicompany -->
        <t t-if="not o and doc">
            <t t-set="o" t-value="doc"/>
        </t>
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id.sudo()"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <!--call to the header template--><!-- t-call = "module_name.header template id"-->
        <t t-call="pr_tax_Invoice_report_custom.custom_invoice_header_layout"/>
        <!--call to the body template-->
        <div class="article">
            <t t-raw="0"/>
        </div><!--call to the footer template-->
        <t t-call="pr_tax_Invoice_report_custom.custom_invoice_footer_layout"/>
    </template>

    <!--Template header-->
    <template id="custom_invoice_header_layout">
        <div class="header" style="height:45mm;">
            <img src='/pr_tax_Invoice_report_custom/static/src/img/petroraq_header_new.png'
                 style="width:100%;height:45mm;"/>
        </div>
    </template>

    <!--Template footer-->
    <template id="custom_invoice_footer_layout">

        <div class="footer">
            <table class="table table-borderless" style="line-height:1.3;font-family: 'DroidArabicNaskh'; margin-bottom:4px;">
                <tr>
                    <td width="50%" style="text-align:left;font-size: 11px; font-weight: bold;">
                        <p>This is computer generated document, no signature and stamp required</p>
                    </td>
                    <td width="50%" style="text-align:right;font-size: 11px;font-weight: bold;">
                        <p>هذه وثيقة تم إنشاؤها بواسطة الكمبيوتر، ولا تتطلب توقيعًا أو ختمًا</p>
                    </td>
                </tr>
            </table>


            <div name="pager" class="list-inline no-margin text-center"
                 style="color:rgba(18,49,96,0.91);border-top:1px solid #305081 !important;width:100%;">
                Page:
                <span class="page"/>
                /
                <span class="topage"/>
            </div>

            <img src='/pr_tax_Invoice_report_custom/static/src/img/img.png'
                 style="width:100%;margin:0;"/>

        </div>
    </template>
</odoo>

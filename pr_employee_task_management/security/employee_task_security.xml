<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_employee_task_management" model="ir.module.category">
        <field name="name">Employee Task Management</field>
        <field name="description">Create, approve, execute, and close employee task lists.</field>
        <field name="sequence">31</field>
    </record>

    <record id="group_task_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="category_id" ref="module_category_employee_task_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_task_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_employee_task_management"/>
        <field name="implied_ids" eval="[(4, ref('group_task_employee'))]"/>
    </record>

    <record id="group_task_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_employee_task_management"/>
        <field name="implied_ids" eval="[(4, ref('group_task_manager')), (4, ref('hr.group_hr_manager'))]"/>
    </record>

    <record id="rule_task_list_employee" model="ir.rule">
        <field name="name">Employee Task Lists - Own</field>
        <field name="model_id" ref="model_employee_task_list"/>
        <field name="groups" eval="[(4, ref('group_task_employee'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_task_list_manager" model="ir.rule">
        <field name="name">Employee Task Lists - Direct Reports</field>
        <field name="model_id" ref="model_employee_task_list"/>
        <field name="groups" eval="[(4, ref('group_task_manager'))]"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('manager_user_id', '=', user.id)]</field>
    </record>

    <record id="rule_task_list_admin" model="ir.rule">
        <field name="name">Employee Task Lists - All</field>
        <field name="model_id" ref="model_employee_task_list"/>
        <field name="groups" eval="[(4, ref('group_task_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_task_line_employee" model="ir.rule">
        <field name="name">Employee Task Lines - Own</field>
        <field name="model_id" ref="model_employee_task_line"/>
        <field name="groups" eval="[(4, ref('group_task_employee'))]"/>
        <field name="domain_force">[('task_list_id.employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_task_line_manager" model="ir.rule">
        <field name="name">Employee Task Lines - Direct Reports</field>
        <field name="model_id" ref="model_employee_task_line"/>
        <field name="groups" eval="[(4, ref('group_task_manager'))]"/>
        <field name="domain_force">['|', ('task_list_id.employee_id.user_id', '=', user.id), ('task_list_id.manager_user_id', '=', user.id)]</field>
    </record>

    <record id="rule_task_line_admin" model="ir.rule">
        <field name="name">Employee Task Lines - All</field>
        <field name="model_id" ref="model_employee_task_line"/>
        <field name="groups" eval="[(4, ref('group_task_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_task_history_employee" model="ir.rule">
        <field name="name">Employee Task History - Own</field>
        <field name="model_id" ref="model_employee_task_approval_history"/>
        <field name="groups" eval="[(4, ref('group_task_employee'))]"/>
        <field name="domain_force">[('task_list_id.employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_task_history_manager" model="ir.rule">
        <field name="name">Employee Task History - Direct Reports</field>
        <field name="model_id" ref="model_employee_task_approval_history"/>
        <field name="groups" eval="[(4, ref('group_task_manager'))]"/>
        <field name="domain_force">['|', ('task_list_id.employee_id.user_id', '=', user.id), ('task_list_id.manager_user_id', '=', user.id)]</field>
    </record>

    <record id="rule_task_history_admin" model="ir.rule">
        <field name="name">Employee Task History - All</field>
        <field name="model_id" ref="model_employee_task_approval_history"/>
        <field name="groups" eval="[(4, ref('group_task_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>


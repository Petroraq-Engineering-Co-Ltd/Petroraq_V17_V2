<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_employee_task_dashboard" model="ir.actions.client">
        <field name="name">Task Dashboard</field>
        <field name="tag">employee_task_management.dashboard</field>
    </record>

    <menuitem id="menu_employee_task_root"
              name="Employee Task Management"
              sequence="36"
              groups="group_task_employee"/>

    <menuitem id="menu_employee_task_dashboard"
              name="Dashboard"
              parent="menu_employee_task_root"
              action="action_employee_task_dashboard"
              sequence="5"/>
    <menuitem id="menu_employee_task_lists"
              name="Task Lists"
              parent="menu_employee_task_root"
              action="action_employee_task_all"
              sequence="10"/>
    <menuitem id="menu_employee_task_my"
              name="My Tasks"
              parent="menu_employee_task_root"
              action="action_employee_task_my"
              sequence="20"/>
    <menuitem id="menu_employee_task_pending"
              name="Pending Approval Tasks"
              parent="menu_employee_task_root"
              action="action_employee_task_pending"
              sequence="30"
              groups="group_task_manager"/>
    <menuitem id="menu_employee_task_approved"
              name="Approved by Manager"
              parent="menu_employee_task_root"
              action="action_employee_task_approved"
              sequence="40"/>
    <menuitem id="menu_employee_task_completed"
              name="Completed Tasks"
              parent="menu_employee_task_root"
              action="action_employee_task_completed"
              sequence="50"/>
    <menuitem id="menu_employee_task_reporting"
              name="Reports"
              parent="menu_employee_task_root"
              action="action_employee_task_reports"
              sequence="60"
              groups="group_task_manager"/>
    <menuitem id="menu_employee_task_configuration"
              name="Configuration"
              parent="menu_employee_task_root"
              sequence="90"
              groups="group_task_admin"/>
    <menuitem id="menu_employee_task_departments"
              name="Departments"
              parent="menu_employee_task_configuration"
              action="hr.hr_department_tree_action"
              sequence="10"/>
    <menuitem id="menu_employee_task_employees"
              name="Employees"
              parent="menu_employee_task_configuration"
              action="hr.open_view_employee_list_my"
              sequence="20"/>
</odoo>

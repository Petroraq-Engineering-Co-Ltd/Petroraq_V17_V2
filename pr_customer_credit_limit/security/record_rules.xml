<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_pr_customer_credit_limit_request_company" model="ir.rule">
        <field name="name">Customer Credit Limit Request: Company</field>
        <field name="model_id" ref="model_pr_customer_credit_limit_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pr_customer_credit_document_type_company" model="ir.rule">
        <field name="name">Customer Credit Document Type: Company</field>
        <field name="model_id" ref="model_pr_customer_credit_document_type"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pr_customer_credit_request_document_company" model="ir.rule">
        <field name="name">Customer Credit Request Document: Company</field>
        <field name="model_id" ref="model_pr_customer_credit_request_document"/>
        <field name="domain_force">[('request_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pr_customer_credit_request_term_company" model="ir.rule">
        <field name="name">Customer Credit Request Term: Company</field>
        <field name="model_id" ref="model_pr_customer_credit_request_term"/>
        <field name="domain_force">[('request_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pr_customer_credit_term_limit_company" model="ir.rule">
        <field name="name">Customer Credit Term Limit: Company</field>
        <field name="model_id" ref="model_pr_customer_credit_term_limit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

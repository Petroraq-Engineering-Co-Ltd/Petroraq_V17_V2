<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_pr_customer_credit_limit" model="ir.ui.view">
        <field name="name">res.partner.form.pr.customer.credit.limit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_credit_limit_requests"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card">
                    <field name="pr_credit_limit_request_count" widget="statinfo" string="Credit Requests"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Credit Facility">
                    <group>
                        <group string="Approved Facility">
                            <field name="pr_credit_limit_currency_id" invisible="1"/>
                            <field name="pr_credit_limit_enabled" readonly="1"/>
                            <field name="pr_credit_limit_amount" readonly="1"/>
                            <field name="pr_credit_limit_approved_request_id" readonly="1"/>
                            <button name="action_create_credit_limit_request"
                                    string="Create Credit Limit Request"
                                    type="object"
                                    class="btn-primary"/>
                            <button name="action_create_opening_credit_facility"
                                    string="Enter Opening Facility"
                                    type="object"
                                    class="btn-secondary"
                                    groups="petroraq_sale_workflow.group_sale_approval_md,base.group_system"
                                    invisible="pr_credit_limit_enabled"/>
                            <button name="action_revise_credit_facility"
                                    string="Revise Facility"
                                    type="object"
                                    class="btn-secondary"
                                    invisible="not pr_credit_limit_enabled"/>
                            <button name="action_reset_credit_facility"
                                    string="Close Facility"
                                    type="object"
                                    class="btn-secondary"
                                    confirm="This creates an approval request to close the facility; it does not close it immediately."
                                    invisible="not pr_credit_limit_enabled"/>
                        </group>
                        <group string="Current Exposure">
                            <field name="pr_credit_limit_receivable_exposure"/>
                            <field name="pr_credit_limit_sale_order_exposure"/>
                            <field name="pr_credit_limit_total_exposure"/>
                            <field name="pr_credit_limit_remaining"/>
                        </group>
                    </group>
                    <separator string="Approved Limits by Payment Term"/>
                    <field name="pr_credit_term_limit_ids" readonly="1">
                        <tree>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="payment_term_id"/>
                            <field name="limit_amount"/>
                            <field name="receivable_exposure"/>
                            <field name="sale_order_exposure"/>
                            <field name="total_exposure"/>
                            <field name="remaining_amount"
                                   decoration-danger="remaining_amount &lt; 0"/>
                            <field name="validity_start" optional="show"/>
                            <field name="validity_end" optional="show"/>
                            <field name="approved_request_id" optional="show"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="de_hr_workspace_account_cash_receipt_view_tree" model="ir.ui.view">
        <field name="name">de.hr.workspace.account.cash.receipt.view.tree</field>
        <field name="model">pr.account.cash.receipt</field>
        <field name="arch" type="xml">
            <tree string="Cash Receipts">
                <field name="name" decoration-warning="1" string="Receipt Number #"/>
                <field name="account_id"/>
                <field name="account_name"/>
                <field name="description"/>
                <field name="accounting_date"/>
                <field name="company_id" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="accounting_manager_state" widget="badge" string="Status"
                       decoration-info="accounting_manager_state in ['submit', 'finance_approve']"
                       decoration-success="accounting_manager_state == 'posted'"
                       decoration-danger="accounting_manager_state in ['reject', 'cancel']"/>
            </tree>
        </field>
    </record>
    <record id="pr_account_cash_receipt_approvals_view_action" model="ir.actions.act_window">
        <field name="name">Cash Receipts</field>
        <field name="res_model">pr.account.cash.receipt</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('de_hr_workspace_account_cash_receipt_view_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('pr_account.account_cash_receipt_view_form')})]"/>
        <field name="domain">[]</field>
        <field name="context">{'create': False, 'edit': False}</field>
        <field name="search_view_id" ref="pr_account.account_cash_receipt_view_search"/>
    </record>
    <record id="pr_account_cash_receipt_approvals_workspace_action" model="ir.actions.server">
        <field name="name">Cash Receipts</field>
        <field name="model_id" ref="pr_account.model_pr_account_cash_receipt"/>
        <field name="state">code</field>
        <field name="code">action = model.action_workspace_cash_receipt_approvals()</field>
    </record>
    <menuitem id="pr_account_cash_receipt_approvals_view_menu" parent="menu_my_financial_accounting_approvals"
              name="Cash Receipts" action="pr_account_cash_receipt_approvals_workspace_action" sequence="1"
              groups="account.group_account_manager,pr_account.custom_group_accounting_manager,pr_account.custom_group_account_supervisor"/>
    <record id="pr_account_cash_receipt_workspace_approval_buttons" model="ir.ui.view">
        <field name="name">pr.account.cash.receipt.workspace.approval.buttons</field>
        <field name="model">pr.account.cash.receipt</field>
        <field name="inherit_id" ref="pr_account.account_cash_receipt_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_finance_approve']" position="attributes">
                <attribute name="groups">account.group_account_manager,pr_account.custom_group_account_supervisor</attribute>
            </xpath>
        </field>
    </record>
</odoo>

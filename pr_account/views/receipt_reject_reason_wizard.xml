<odoo>
    <record id="view_receipt_reject_reason_wizard" model="ir.ui.view">
        <field name="name">receipt.reject.reason.wizard.form</field>
        <field name="model">receipt.reject.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Receipt Voucher">
                <group>
                    <field name="bank_receipt_id" invisible="1"/>
                    <field name="cash_receipt_id" invisible="1"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
